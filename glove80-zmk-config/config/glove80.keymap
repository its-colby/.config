/*
 * Glove80 keymap: stock non-letter keys + Goku letter simlayers.
 * Only letter keys use hold-to-layer (A S D F G R V C X / H J K L U I O H).
 * Escape, Tab, thumbs, mods, Magic, Lower, punctuation, etc. stay stock.
 *
 * Unicode paste macros (⟨⟩, ≡, ∈, …) use macOS Unicode Hex Input
 * (hold Option, type hex, release). Enable that input source for those keys.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// Layer indices — LOWER/MAGIC/FACTORY keep stock roles; Goku layers in between
#define DEFAULT 0
#define LOWER   1
#define L_F     2   // f-text-editing
#define L_D     3   // d-dual-punctuation
#define L_S     4   // s-solo-punctuation
#define L_A     5   // a-6-through-0
#define L_R     6   // r-recording
#define L_V     7   // v-relations
#define L_C     8   // c-operators
#define L_X     9   // x-logic
#define L_G     10  // g-left-shift
#define L_J     11  // j-text-navigation
#define L_K     12  // k-tab-navigation
#define L_L     13  // l-window-navigation
#define L_SEMI  14  // semicolon-1-through-5 (Goku; hold ; tap types ;)
#define L_U     15  // u-file-navigation
#define L_I     16  // i-text-selection
#define L_O     17  // o-audio-visual
#define L_H     18  // h-right-shift
#define MAGIC   19
#define FACTORY_TEST 20

/ {
    behaviors {
        // Stock Lower: hold = momentary, double-tap = toggle
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LOWER>, <&to LOWER>;
        };

        // Approximates Goku simlayers: hold → momentary layer, tap → key.
        // tapping-term matches Goku :sim 200.
        slt: simlayer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "SIMLAYER_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        // Dual punctuation wrappers (type pair, move left into middle)
        m_parens: m_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LPAR &kp RPAR &kp LEFT>;
        };
        m_brackets: m_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LBKT &kp RBKT &kp LEFT>;
        };
        m_braces: m_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LBRC &kp RBRC &kp LEFT>;
        };
        m_dquote: m_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp DQT &kp DQT &kp LEFT>;
        };
        m_squote: m_squote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp SQT &kp SQT &kp LEFT>;
        };
        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp GRAVE &kp GRAVE &kp LEFT>;
        };

        // macOS Unicode Hex Input: hold Option, type 4 hex digits, release.
        // ⟨ U+27E8  ⟩ U+27E9 — paste-left ⟨⟩
        m_angles: m_angles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp N2 &kp N7 &kp E &kp N8>
                , <&macro_release &kp LALT>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp N2 &kp N7 &kp E &kp N9>
                , <&macro_release &kp LALT>
                , <&macro_tap &kp LEFT>;
        };

        // ≡ 2261
        m_equiv: m_equiv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N6 &kp N1>, <&macro_release &kp LALT>;
        };
        // ≢ 2262
        m_nequiv: m_nequiv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N6 &kp N2>, <&macro_release &kp LALT>;
        };
        // ∼ 223C
        m_sim: m_sim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N3 &kp C>, <&macro_release &kp LALT>;
        };
        // ∈ 2208
        m_in: m_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N0 &kp N8>, <&macro_release &kp LALT>;
        };
        // ∉ 2209
        m_notin: m_notin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N0 &kp N9>, <&macro_release &kp LALT>;
        };
        // ⊆ 2286
        m_subseteq: m_subseteq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N8 &kp N6>, <&macro_release &kp LALT>;
        };
        // ⊇ 2287
        m_supseteq: m_supseteq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N8 &kp N7>, <&macro_release &kp LALT>;
        };
        // ⊄ 2284
        m_nsubset: m_nsubset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N8 &kp N4>, <&macro_release &kp LALT>;
        };
        // ⊅ 2285
        m_nsuperset: m_nsuperset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N8 &kp N5>, <&macro_release &kp LALT>;
        };
        // ∘ 2218
        m_circ: m_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N1 &kp N8>, <&macro_release &kp LALT>;
        };
        // ↦ 21A6
        m_mapsto: m_mapsto {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N1 &kp A &kp N6>, <&macro_release &kp LALT>;
        };
        // × 00D7
        m_times: m_times {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N0 &kp N0 &kp D &kp N7>, <&macro_release &kp LALT>;
        };
        // ⊕ 2295
        m_oplus: m_oplus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N9 &kp N5>, <&macro_release &kp LALT>;
        };
        // ⊗ 2297
        m_otimes: m_otimes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N9 &kp N7>, <&macro_release &kp LALT>;
        };
        // ⊙ 2299
        m_odot: m_odot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N9 &kp N9>, <&macro_release &kp LALT>;
        };
        // → 2192
        m_rarr: m_rarr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N1 &kp N9 &kp N2>, <&macro_release &kp LALT>;
        };
        // ← 2190
        m_larr: m_larr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N1 &kp N9 &kp N0>, <&macro_release &kp LALT>;
        };
        // ↑ 2191
        m_uarr: m_uarr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N1 &kp N9 &kp N1>, <&macro_release &kp LALT>;
        };
        // ↓ 2193
        m_darr: m_darr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N1 &kp N9 &kp N3>, <&macro_release &kp LALT>;
        };
        // ∧ 2227
        m_land: m_land {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N2 &kp N7>, <&macro_release &kp LALT>;
        };
        // ∨ 2228
        m_lor: m_lor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N2 &kp N8>, <&macro_release &kp LALT>;
        };
        // ∃ 2203
        m_exists: m_exists {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N0 &kp N3>, <&macro_release &kp LALT>;
        };
        // ∀ 2200
        m_forall: m_forall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N0 &kp N0>, <&macro_release &kp LALT>;
        };
        // ¬ 00AC (also Option+L on US Mac)
        m_not: m_not {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(L)>;
        };
        // ⟹ 27F9
        m_implies: m_implies {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N7 &kp F &kp N9>, <&macro_release &kp LALT>;
        };
        // ⟺ 27FA
        m_iff: m_iff {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N7 &kp F &kp A>, <&macro_release &kp LALT>;
        };
        // ⊢ 22A2
        m_vdash: m_vdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp A &kp N2>, <&macro_release &kp LALT>;
        };
        // ⊨ 22A8
        m_models: m_models {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp A &kp N8>, <&macro_release &kp LALT>;
        };
        // ⊤ 22A4
        m_top: m_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp A &kp N4>, <&macro_release &kp LALT>;
        };
        // ⊥ 22A5
        m_bot: m_bot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp A &kp N5>, <&macro_release &kp LALT>;
        };
        // ∴ 2234
        m_therefore: m_therefore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2 &kp N2 &kp N3 &kp N4>, <&macro_release &kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // DEFAULT — stock Glove80 non-letters; only letters get Goku hold-layers
        // =====================================================================
        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                                                 |  Y   |   U   |   I   |  O   |   P   |   \  |
            // |  ESC  |  A  |  S  |  D   |  F   |  G   |                                                 |  H   |   J   |   K   |  L   |   ;   |   '  |
            // |   `   |  Z  |  X  |  C   |  V   |  B   | LSHFT | LCTRL | LOWER | | LGUI  | RCTRL | RSHFT |  N   |   M   |   ,   |  .   |   /   | PGUP |
            // | MAGIC | HOME| END | LEFT | RIGHT|      | BSPC  | DEL   | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

            bindings = <
            &kp F1         &kp F2   &kp F3      &kp F4      &kp F5                                                                                         &kp F6  &kp F7      &kp F8      &kp F9      &kp F10
            &kp EQUAL      &kp N1   &kp N2      &kp N3      &kp N4      &kp N5                                                                     &kp N6  &kp N7  &kp N8      &kp N9      &kp N0      &kp MINUS
            &kp TAB        &kp Q    &kp W       &kp E       &slt L_R R  &kp T                                                                      &kp Y   &slt L_U U &slt L_I I &slt L_O O &kp P       &kp BSLH
            &kp ESC        &slt L_A A &slt L_S S &slt L_D D &slt L_F F  &slt L_G G                                                                 &slt L_H H &slt L_J J &slt L_K K &slt L_L L &slt L_SEMI SEMI &kp SQT
            &kp GRAVE      &kp Z    &slt L_X X  &slt L_C C  &slt L_V V  &kp B   &kp LSHFT   &kp LCTRL   &layer_td  &kp LGUI  &kp RCTRL &kp RSHFT   &kp N   &kp M   &kp COMMA   &kp DOT     &kp FSLH    &kp PG_UP
            &magic MAGIC 0 &kp HOME &kp END     &kp LEFT    &kp RIGHT          &kp BSPC    &kp DEL     &kp LALT   &kp RALT  &kp RET   &kp SPACE           &kp UP  &kp DOWN    &kp LBKT    &kp RBKT    &kp PG_DN
            >;
        };

        // Stock Lower layer (unchanged from MoErgo default)
        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                           &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none           &kp PAUSE_BREAK
            &trans            &none               &none           &none           &none           &kp HOME                                                                              &kp LPAR     &kp KP_NUM   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                               &kp RPAR     &kp KP_N7    &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                             &kp PRCNT    &kp KP_N4    &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN       &trans      &trans      &to DEFAULT &trans      &trans      &trans    &kp COMMA    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                         &trans      &trans      &trans      &trans      &trans      &trans                 &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER    &trans
            >;
        };

        // =====================================================================
        // F — text editing
        // =====================================================================
        layer_f {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &kp LG(LBKT) &kp LG(RBKT) &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &kp BSPC &kp RET &kp TAB &kp LS(RET) &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp DEL &kp LA(BSPC) &kp LA(DEL) &kp LG(BSPC) &kp LG(DEL) &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // D — dual punctuation
        // =====================================================================
        layer_d {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &m_dquote &kp DQT &m_squote &kp SQT &trans
&trans &trans &trans &trans &trans &trans                                       &m_grave &m_parens &m_brackets &m_braces &m_angles &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // S — solo punctuation
        // =====================================================================
        layer_s {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &kp PLUS &kp STAR &kp HASH &kp BSLH &trans
&trans &trans &trans &trans &trans &trans                                       &kp PIPE &kp EQUAL &kp MINUS &kp UNDER &kp FSLH &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp TILDE &kp PRCNT &kp CARET &kp AMPS &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // A — 6 through 0 (+ ∞ ∅)
        // =====================================================================
        layer_a {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &kp LA(N5) &kp LA(LS(O)) &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // R — recording (Ctrl+Opt chords + F13)
        // =====================================================================
        layer_r {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &kp LC(LA(A)) &kp LC(LA(B)) &kp F13 &kp LC(LA(D)) &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // V — relations
        // =====================================================================
        layer_v {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &m_nsubset &kp LA(COMMA) &kp LA(DOT) &kp LT &kp GT &trans
&trans &trans &trans &trans &trans &trans                                       &m_sim &kp EQUAL &kp LA(EQUAL) &m_equiv &m_nequiv &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &m_nsuperset &m_in &m_notin &m_subseteq &m_supseteq &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // C — operators
        // =====================================================================
        layer_c {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &m_times &m_oplus &m_otimes &m_odot &trans
&trans &trans &trans &trans &trans &trans                                       &m_mapsto &kp PLUS &kp LA(LS(N9)) &m_circ &kp LA(LS(EQUAL)) &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &m_rarr &m_larr &m_uarr &m_darr &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // X — logic
        // =====================================================================
        layer_x {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &m_implies &m_iff &m_vdash &m_models &trans
&trans &trans &trans &trans &trans &trans                                       &m_not &m_land &m_lor &m_exists &m_forall &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &m_top &m_bot &m_therefore &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // G — left shift (shifted counterparts on right hand)
        // =====================================================================
        layer_g {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &kp LS(Y) &kp LS(U) &kp LS(I) &kp LS(O) &kp LS(P) &trans
&trans &trans &trans &trans &trans &trans                                       &kp LS(H) &kp LS(J) &kp LS(K) &kp LS(L) &kp SEMI &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp LS(N) &kp LS(M) &kp EXCL &kp QMARK &kp DLLR &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // J — text navigation
        // =====================================================================
        layer_j {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LG(LEFT) &kp LG(RIGHT) &kp LA(LEFT) &kp LA(RIGHT) &trans              &trans &trans &trans &trans &trans &trans
&trans &kp DOWN &kp UP &kp LEFT &kp RIGHT &trans                                 &trans &trans &trans &trans &trans &trans
&trans &kp LS(LA(LC(Z))) &kp LS(LA(LC(X))) &kp LC(LA(EQUAL)) &kp LS(LA(LC(V))) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // K — tab / tmux / arc navigation
        // =====================================================================
        layer_k {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LG(LBKT) &kp LG(RBKT) &kp LC(LA(E)) &kp LC(LA(R)) &kp LC(LA(Q))     &trans &trans &trans &trans &trans &trans
&trans &kp LC(LA(A)) &kp LC(LA(S)) &kp LC(LA(D)) &kp LC(LA(F)) &kp LC(LA(G))   &trans &trans &trans &trans &trans &trans
&trans &kp END &kp HOME &kp PG_DN &kp PG_UP &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &kp LC(LA(W)) &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // L — aerospace window navigation
        // =====================================================================
        layer_l {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LS(LA(Q)) &kp LS(LA(W)) &kp LS(LA(E)) &kp LS(LA(R)) &trans          &trans &trans &trans &trans &trans &trans
&trans &kp LS(LA(A)) &kp LS(LA(S)) &kp LS(LA(D)) &kp LS(LA(F)) &trans          &trans &trans &trans &trans &trans &trans
&trans &trans &trans &kp LS(LA(C)) &kp LS(LA(V)) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &kp LS(LA(SPACE)) &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // SEMI — 1 through 5
        // =====================================================================
        layer_semi {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                                      &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // U — file navigation
        // =====================================================================
        layer_u {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LG(LS(G)) &kp LG(G) &kp LG(LA(F)) &kp LG(F) &trans                 &trans &trans &trans &trans &trans &trans
&trans &kp LS(TAB) &kp TAB &kp LG(LS(Z)) &kp LG(Z) &kp F2                     &trans &trans &trans &trans &trans &trans
&trans &trans &trans &kp ESC &kp LG(S) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &kp LS(LG(LA(M))) &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // I — text selection
        // =====================================================================
        layer_i {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LS(DOWN) &kp LS(UP) &kp LS(LEFT) &kp LS(RIGHT) &trans               &trans &trans &trans &trans &trans &trans
&trans &kp LS(LG(LEFT)) &kp LS(LG(RIGHT)) &kp LS(LA(LEFT)) &kp LS(LA(RIGHT)) &kp LG(A) &trans &trans &trans &trans &trans &trans
&trans &kp LG(LS(V)) &kp LG(C) &kp LG(X) &kp LG(V) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &kp LG(FSLH) &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // O — audio / visual
        // =====================================================================
        layer_o {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &kp LG(L) &trans                                    &trans &trans &trans &trans &trans &trans
&trans &kp C_BRI_DN &kp C_BRI_UP &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE          &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // H — right shift (shifted counterparts on left hand)
        // =====================================================================
        layer_h {
            bindings = <
&trans &trans &trans &trans &trans                                                     &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                                       &trans &trans &trans &trans &trans &trans
&trans &kp LS(Q) &kp LS(W) &kp LS(E) &kp LS(R) &kp LS(T)                       &trans &trans &trans &trans &trans &trans
&trans &kp LS(A) &kp LS(S) &kp LS(D) &kp LS(F) &kp LS(G)                       &trans &trans &trans &trans &trans &trans
&trans &kp LS(Z) &kp LS(X) &kp LS(C) &kp LS(V) &kp LS(B) &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };

        // =====================================================================
        // MAGIC — Bluetooth / RGB / bootloader (stock Glove80)
        // =====================================================================
        magic_layer {
            bindings = <
&bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
&none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
&none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
&bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
&sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
&none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
&kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
&kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
&kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
&kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
&kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
&kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
