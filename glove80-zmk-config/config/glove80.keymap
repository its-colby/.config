/*
 * Glove80 keymap — firmware Graphite alphas (HID letter codes).
 *
 * macOS input source must stay US/QWERTY. Do NOT enable an OS Graphite layout
 * (it would double-map Glove80). Mac builtin Graphite is done in Goku/Karabiner
 * with :is_built_in_keyboard only.
 *
 * Shared actions (apps, window mgmt) emit chords; Hammerspoon runs the scripts.
 * Karabiner must not handle Glove80.
 *
 * Unicode macros use macOS Unicode Hex Input for math/logic paste keys.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#include "layout_helpers.dtsi"

// Layer indices — LOWER/MAGIC/FACTORY keep stock roles
// Source order below: upper/home/thumb × left/right, inward → outward.
// Numeric indices kept stable for keymap compatibility.
#define DEFAULT 0
#define LOWER   1
#define L_W     2   // Upper L: Graphite W — Dual punctuation (QWERTY R)
#define L_D     4   // Upper L: Graphite D — Solo punctuation (QWERTY E)
#define L_L     7   // Upper L: Graphite L — Misc punctuation (QWERTY W)
#define L_B     6   // Upper L: Graphite B — Logic symbols (QWERTY Q)
#define L_F     3   // Upper R: Graphite F — Math relations (QWERTY U)
#define L_O     5   // Upper R: Graphite O — Math operators (QWERTY I)
#define L_U     8   // Upper R: Graphite U — IPA symbols (QWERTY O)
#define L_S     12  // Home L: Graphite S — Primary apps (QWERTY F)
#define L_T     11  // Home L: Graphite T — Secondary apps (QWERTY D)
#define L_R     10  // Home L: Graphite R — Inner app nav (QWERTY S)
#define L_N     9   // Home L: Graphite N — Window management (QWERTY A)
#define L_H     13  // Home R: Graphite H — Browser (QWERTY J)
#define L_A     14  // Home R: Graphite A — Clipboard & edit (QWERTY K)
#define L_E     15  // Home R: Graphite E — Text selection (QWERTY L)
#define L_I     16  // Home R: Graphite I — Find & navigate (QWERTY ;)
#define L_AUDIO 17  // Thumb L: Tab-key hold — Audio & display
#define L_WDEL  18  // Thumb R: Space hold — Word deletion
#define L_WNAV  19  // Thumb R: Enter hold — Word navigation
#define L_RU    20  // Toggle: Vestnik Russian (tap RCTRL)
#define MAGIC   21
#define FACTORY_TEST 22

// Built-in layer-tap (&lt): hold → momentary layer, tap → key.
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
    quick-tap-ms = <400>;
};

/ {
    behaviors {
        // Stock Lower: hold = momentary, double-tap = toggle
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LOWER>, <&to LOWER>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        // Base punctuation (shift morphs). Physical positions as specified.
        mm_y: mod_morph_y {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Graphite . (phys comma): period / !
        mm_dotkey: mod_morph_dotkey {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Graphite - (phys period): hyphen / _
        mm_minus: mod_morph_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Under I (phys /): semicolon / colon
        mm_fslh: mod_morph_fslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Right of I (phys '): slash / backslash
        mm_sqt: mod_morph_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Right of J (phys \ on Glove80 alpha row): ? / |
        mm_bslh: mod_morph_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Bracket keys: [/{ and ]/}
        mm_lbkt: mod_morph_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_rbkt: mod_morph_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        // Dual punctuation wrappers (type pair, cursor between)
        WRAP(m_parens,   LPAR,  RPAR);
        WRAP(m_brackets, LBKT,  RBKT);
        WRAP(m_braces,   LBRC,  RBRC);
        WRAP(m_dquote,   DQT,   DQT);
        WRAP(m_squote,   SQT,   SQT);
        WRAP(m_grave,    GRAVE, GRAVE);
        UC2_LEFT(m_angles, N2, N7, E, N8, N2, N7, E, N9); // ⟨⟩ then Left

        // macOS Unicode Hex Input (Option + 4 hex digits)
        UC(m_equiv,     N2, N2, N6, N1); // ≡
        UC(m_nequiv,    N2, N2, N6, N2); // ≢
        UC(m_sim,       N2, N2, N3, C);  // ∼
        UC(m_approx,    N2, N2, N4, N8); // ≈
        UC(m_coloneq,   N2, N2, N5, N4); // ≔
        UC(m_in,        N2, N2, N0, N8); // ∈
        UC(m_notin,     N2, N2, N0, N9); // ∉
        UC(m_subseteq,  N2, N2, N8, N6); // ⊆
        UC(m_supseteq,  N2, N2, N8, N7); // ⊇
        UC(m_subset,    N2, N2, N8, N2); // ⊂
        UC(m_superset,  N2, N2, N8, N3); // ⊃
        UC(m_nsubset,   N2, N2, N8, N4); // ⊄
        UC(m_nsuperset, N2, N2, N8, N5); // ⊅
        UC(m_cong,      N2, N2, N4, N5); // ≅
        UC(m_ncong,     N2, N2, N4, N7); // ≇
        UC(m_propto,    N2, N2, N1, D);  // ∝
        UC(m_ni,        N2, N2, N0, B);  // ∋
        UC(m_notni,     N2, N2, N0, C);  // ∌
        UC(m_circ,      N2, N2, N1, N8); // ∘
        UC(m_mapsto,    N2, N1, A,  N6); // ↦
        UC(m_times,     N0, N0, D,  N7); // ×
        UC(m_div,       N0, N0, F,  N7); // ÷
        UC(m_sqrt,      N2, N2, N1, A);  // √
        UC(m_cap,       N2, N2, N2, N9); // ∩
        UC(m_cup,       N2, N2, N2, A);  // ∪
        UC(m_setminus,  N2, N2, N1, N6); // ∖
        UC(m_sum,       N2, N2, N1, N1); // ∑
        UC(m_prod,      N2, N2, N0, F);  // ∏
        UC(m_int,       N2, N2, N2, B);  // ∫
        UC(m_partial,   N2, N2, N0, N2); // ∂
        UC(m_lrarr,     N2, N1, N9, N4); // ↔
        UC(m_oplus,     N2, N2, N9, N5); // ⊕
        UC(m_otimes,    N2, N2, N9, N7); // ⊗
        UC(m_odot,      N2, N2, N9, N9); // ⊙
        UC(m_rarr,      N2, N1, N9, N2); // →
        UC(m_larr,      N2, N1, N9, N0); // ←
        UC(m_uarr,      N2, N1, N9, N1); // ↑
        UC(m_darr,      N2, N1, N9, N3); // ↓
        UC(m_land,      N2, N2, N2, N7); // ∧
        UC(m_lor,       N2, N2, N2, N8); // ∨
        UC(m_exists,    N2, N2, N0, N3); // ∃
        UC(m_forall,    N2, N2, N0, N0); // ∀
        UC(m_implies,   N2, N7, F,  N9); // ⟹
        UC(m_iff,       N2, N7, F,  A);  // ⟺
        UC(m_vdash,     N2, N2, A,  N2); // ⊢
        UC(m_models,    N2, N2, A,  N8); // ⊨
        UC(m_top,       N2, N2, A,  N4); // ⊤
        UC(m_bot,       N2, N2, A,  N5); // ⊥
        UC(m_therefore, N2, N2, N3, N4); // ∴
        UC(m_inf,       N2, N2, N1, E);  // ∞
        UC(m_emptyset,  N2, N2, N0, N5); // ∅
        UC(m_leq,       N2, N2, N6, N4); // ≤
        UC(m_geq,       N2, N2, N6, N5); // ≥
        UC(m_neq,       N2, N2, N6, N0); // ≠
        UC(m_middot,    N0, N0, B,  N7); // ·
        UC(m_pm,        N0, N0, B,  N1); // ±

        // IPA (Graphite U) — RU > DE > EN, non-Latin, by frequency
        UC(m_palatal,   N0, N2, B,  N2); // ʲ
        UC(m_schwa,     N0, N2, N5, N9); // ə
        UC(m_barred_i,  N0, N2, N6, N8); // ɨ
        UC(m_esh,       N0, N2, N8, N3); // ʃ
        UC(m_ezh,       N0, N2, N9, N2); // ʒ
        UC(m_c_curl,    N0, N2, N5, N5); // ɕ
        UC(m_turned_a,  N0, N2, N5, N0); // ɐ
        UC(m_ccedil,    N0, N0, E,  N7); // ç
        UC(m_inv_R,     N0, N2, N8, N1); // ʁ
        UC(m_eng,       N0, N1, N4, B);  // ŋ
        UC(m_sml_cap_i, N0, N2, N6, A);  // ɪ
        UC(m_upsilon,   N0, N2, N8, A);  // ʊ
        UC(m_open_o,    N0, N2, N5, N4); // ɔ
        UC(m_epsilon,   N0, N2, N5, B);  // ɛ
        UC(m_o_slash,   N0, N0, F,  N8); // ø
        UC(m_length,    N0, N2, D,  N0); // ː

        UC(m_not,       N0, N0, A,  C);  // ¬

#include "russian_macros.inc"
    };

    behaviors {
#include "russian_behaviors.inc"
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // DEFAULT — Graphite letter HID (OS must be US/QWERTY)
        //   b l d w z  , f o u j  \
        //   n r t s g  y h a e i  '
        //   q x m c v  k p . - /
        // =====================================================================
        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // | BRIDN | BRIUP | VOLDN | VOLUP |  F5  |                                                               |  F6   |  F7   |  F8  | ZOOM+ | ZOOM- |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
            // | VOLUP |  B  |  L  |  D   |  W   |  Z   |                                                 |  ,   |   F   |   O   |  U   |   J   |   \  |
            // | VOLDN |  N  |  R  |  T   |  S   |  G   |                                                 |  Y   |   H   |   A   |  E   |   I   |   '  |
            // |   `   |  Q  |  X  |  M   |  C   |  V   | LSHFT | CAPS  | LOWER | | LGUI  | RU/RC | RSHFT |  K   |   P   |   .   |  -   |   /   | PGUP |
            // | MAGIC |BRIDN|BRIUP| LEFT | RIGHT|      | BSPC  | TAB   | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

            bindings = <
            &kp C_BRI_DN   &kp C_BRI_UP &kp C_VOL_DN &kp C_VOL_UP &kp F5                                                                                         &kp F6  &kp F7      &kp F8      &kp LG(EQUAL) &kp LG(MINUS)
            &kp EQUAL      &kp N1   &kp N2      &kp N3      &kp N4      &kp N5                                                                     &kp N6  &kp N7  &kp N8      &kp N9      &kp N0      &kp MINUS
            &kp C_VOL_UP   &lt L_B B &lt L_L L   &lt L_D D   &lt L_W W   &kp Z                                                                      &mm_y   &lt L_F F  &lt L_O O  &lt L_U U  &kp J       &mm_bslh
            &kp C_VOL_DN   &lt L_N N &lt L_R R  &lt L_T T   &lt L_S S   &kp G                                                                      &kp Y   &lt L_H H  &lt L_A A  &lt L_E E  &lt L_I I   &mm_sqt
            &kp GRAVE      &kp Q    &kp X       &kp M       &kp C       &kp V   &kp LSHFT   &kp CAPS    &layer_td  &kp LGUI  &ru_tog RCTRL L_RU &kp RSHFT   &kp K   &kp P   &mm_dotkey  &mm_minus   &mm_fslh    &kp PG_UP
            &magic MAGIC 0 &kp C_BRI_DN &kp C_BRI_UP &kp LEFT &kp RIGHT        &kp BSPC    &lt L_AUDIO TAB &kp LALT &kp RALT &lt L_WNAV RET &lt L_WDEL SPACE &kp UP &kp DOWN &mm_lbkt &mm_rbkt &kp PG_DN
            >;
        };

        // Stock Lower layer (unchanged from MoErgo default)
        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                           &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none           &kp PAUSE_BREAK
            &trans            &none               &none           &none           &none           &kp HOME                                                                              &kp LPAR     &kp KP_NUM   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                               &kp RPAR     &kp KP_N7    &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                             &kp PRCNT    &kp KP_N4    &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN       &trans      &trans      &to DEFAULT &trans      &trans      &trans    &kp COMMA    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                         &trans      &trans      &trans      &trans      &trans      &trans                 &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER    &trans
            >;
        };

        // =====================================================================
        // Layers — opposite-hand only via LAYER_LEFT / LAYER_RIGHT
        // Args are QWERTY positions; comments note Graphite roles.
        // LAYER_RIGHT(y,u,i,o,p,  h,j,k,l,;,  n,m,,,.,/,  space)
        // LAYER_LEFT (q,w,e,r,t,  a,s,d,f,g,  z,x,c,v,b,  space)
        // =====================================================================

        // =====================================================================
        // UPPER LEFT (inward → outward): W D L B
        // =====================================================================

        // Graphite W, QWERTY R — Dual punctuation
        layer_w {
            bindings = <
            LAYER_RIGHT(
                ___, ___, ___, ___, ___,
                ___, &m_dquote, &kp DQT, &m_squote, &kp SQT,
                &m_grave, &m_parens, &m_brackets, &m_braces, &m_angles,
                ___
            )
            >;
        };

        // Graphite D, QWERTY E — Solo punctuation
        layer_d {
            bindings = <
            LAYER_RIGHT(
                &kp PLUS, &kp STAR, &kp HASH, &kp BSLH, &kp MINUS,
                &kp PIPE, &kp EQUAL, &kp MINUS, &kp UNDER, ___,
                &kp MINUS, &kp TILDE, &kp PRCNT, &kp CARET, &kp AMPS,
                ___
            )
            >;
        };

        // Graphite L, QWERTY W — Misc punctuation
        layer_l {
            bindings = <
            LAYER_RIGHT(
                &kp SEMI, &kp EXCL, &kp QMARK, &kp DLLR, &kp FSLH,
                &m_inf, &m_emptyset, &m_pm, &m_models, ___,
                &m_top, &m_bot, &m_therefore, ___, ___,
                ___
            )
            >;
        };

        // Graphite B, QWERTY Q — Logic symbols
        // F⊤ O⊥ U⊨ | Y¬ H∧ A∨ E∃ I∀ | Space∴
        layer_b {
            bindings = <
            LAYER_RIGHT(
                ___, &m_top, &m_bot, &m_models, ___,
                &m_not, &m_land, &m_lor, &m_exists, &m_forall,
                ___, ___, ___, ___, ___,
                &m_therefore
            )
            >;
        };

        // =====================================================================
        // UPPER RIGHT (inward → outward): F O U
        // =====================================================================

        // Graphite F, QWERTY U — Math relations (rows cycled LEFT)
        // B≤ L≥ D≅ W≇ Z∝ | N< R> T= S≠ G≈ | Q⊂ X⊃ M∈ C∉ V∼ | Space≔
        layer_f {
            bindings = <
            LAYER_LEFT(
                &m_leq, &m_geq, &m_cong, &m_ncong, &m_propto,
                &kp LT, &kp GT, &kp EQUAL, &m_neq, &m_approx,
                &m_subset, &m_superset, &m_in, &m_notin, &m_sim,
                &m_coloneq
            )
            >;
        };

        // Graphite O, QWERTY I — Math operators
        // B± L× D∩ W∪ Z∘ | N÷ R· T- S+ G√ | Q∂ X∫ M∏ C∑ V↦ | Space∖
        layer_o {
            bindings = <
            LAYER_LEFT(
                &m_pm, &m_times, &m_cap, &m_cup, &m_circ,
                &m_div, &m_middot, &kp MINUS, &kp PLUS, &m_sqrt,
                &m_partial, &m_int, &m_prod, &m_sum, &m_mapsto,
                &m_setminus
            )
            >;
        };

        // Graphite U, QWERTY O — IPA (per-row freq: index→left→center)
        // Bɪ Lɐ Dɨ Wə Zʊ | Nŋ Rɔ Tɛ Sʲ Gø | Qʁ Xɕ Mʒ Cʃ Vç | Spaceː
        layer_u {
            bindings = <
            LAYER_LEFT(
                &m_sml_cap_i, &m_turned_a, &m_barred_i, &m_schwa, &m_upsilon,
                &m_eng, &m_open_o, &m_epsilon, &m_palatal, &m_o_slash,
                &m_inv_R, &m_c_curl, &m_ezh, &m_esh, &m_ccedil,
                &m_length
            )
            >;
        };

        // =====================================================================
        // HOME LEFT (inward → outward): S T R N
        // =====================================================================

        // Graphite S, QWERTY F — Primary apps (was H; flipped to right hand)
        // Y/H/A/E = apps 1-4
        layer_s {
            bindings = <
            LAYER_RIGHT(
                ___, ___, ___, ___, ___,
                &kp HYPER(N1), &kp HYPER(N2), &kp HYPER(N3), &kp HYPER(N4), ___,
                ___, ___, ___, ___, ___,
                &kp LS(LA(SPACE))
            )
            >;
        };

        // Graphite T, QWERTY D — Secondary apps (was S)
        // Upper: F WhatsApp … J Calendar; Y Messages; , Spotify; Space = Delete
        layer_t {
            bindings = <
            LAYER_RIGHT(
                &kp HYPER(P), &kp HYPER(Q), &kp HYPER(W), &kp HYPER(E), &kp HYPER(R),
                &kp HYPER(O), &kp HYPER(T), &kp HYPER(Y), &kp HYPER(U), &kp HYPER(I),
                ___, ___, ___, ___, ___,
                &kp DEL
            )
            >;
        };

        // Graphite R, QWERTY S — Inner app nav (was A; flipped to right)
        // H left sidebar, A right sidebar, E bottom; F/O zoom; U/J page
        layer_r {
            bindings = <
            LAYER_RIGHT(
                ___, &kp LG(EQUAL), &kp LG(MINUS), &kp PG_UP, &kp PG_DN,
                ___, &kp LG(B), &kp LG(LA(B)), &kp LG(J), ___,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // Graphite N, QWERTY A — Window management (was I; flipped to right)
        // F/O resize; Y swap; H/A focus; E accordion; I split
        layer_n {
            bindings = <
            LAYER_RIGHT(
                ___, &kp LS(LA(C)), &kp LS(LA(V)), ___, ___,
                &kp LS(LA(A)), &kp LS(LA(D)), &kp LS(LA(F)), &kp LS(LA(Q)), &kp LS(LA(W)),
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // =====================================================================
        // HOME RIGHT (inward → outward): H A E I
        // =====================================================================

        // Graphite H, QWERTY J — Browser (was T; flipped to left)
        // D/W links; L split; R new; T prev; S next; N switch spaces
        layer_h {
            bindings = <
            LAYER_LEFT(
                ___, &kp LC(LA(E)), &kp LG(LBKT), &kp LG(RBKT), ___,
                &kp LC(LA(Q)), &kp LC(LA(G)), &kp LC(LA(D)), &kp LC(LA(F)), ___,
                ___, ___, ___, ___, ___,
                &kp LC(LA(W))
            )
            >;
        };

        // Graphite A, QWERTY K — Clipboard & edit (was E)
        layer_a {
            bindings = <
            LAYER_LEFT(
                ___, ___, &kp LG(LS(V)), &kp LG(LS(Z)), ___,
                &kp LG(C), &kp LG(X), &kp LG(V), &kp LG(Z), ___,
                ___, ___, ___, ___, ___,
                &kp LG(FSLH)
            )
            >;
        };

        // Graphite E, QWERTY L — Text selection (was R; flipped to left)
        // Home: N/R word, T/S line start/end
        layer_e {
            bindings = <
            LAYER_LEFT(
                &kp LS(UP), &kp LS(DOWN), &kp LS(RIGHT), &kp LS(LEFT), ___,
                &kp LS(LA(LEFT)), &kp LS(LA(RIGHT)), &kp LS(LG(LEFT)), &kp LS(LG(RIGHT)), ___,
                ___, ___, ___, ___, ___,
                &kp LG(A)
            )
            >;
        };

        // Graphite I, QWERTY ; — Find & navigate (was N; flipped to left)
        layer_i {
            bindings = <
            LAYER_LEFT(
                &kp LG(F), &kp LG(LA(F)), &kp LG(G), &kp LG(LS(G)), &kp F2,
                ___, &kp TAB, &kp LS(TAB), &kp LG(S), &kp ESC,
                ___, ___, ___, ___, ___,
                &kp LS(LG(LA(M)))
            )
            >;
        };

        // =====================================================================
        // THUMB LEFT
        // =====================================================================

        // Caps-key position (now Tab tap) hold — Audio & display
        layer_audio {
            bindings = <
            LAYER_LEFT(
                ___, &kp LG(L), ___, ___, ___,
                &kp C_MUTE, &kp C_VOL_UP, &kp C_VOL_DN, &kp C_BRI_UP, ___,
                &kp C_BRI_DN, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // =====================================================================
        // THUMB RIGHT (inward → outward): Word Nav, Word Del
        // =====================================================================

        // Enter hold — Word navigation
        // L down, D up, W left, Z right; T line start, S line end
        layer_wnav {
            bindings = <
            LAYER_LEFT(
                ___, &kp DOWN, &kp UP, &kp LEFT, &kp RIGHT,
                &kp LA(LEFT), &kp LA(RIGHT), &kp LG(LEFT), &kp LG(RIGHT), ___,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // Space hold — Word deletion
        // D deindent, W indent; N/R word; T/S line; opp. thumb = Delete
        layer_wdel {
            bindings = <
            LAYER_LEFT(
                ___, ___, &kp LG(LBKT), &kp LG(RBKT), ___,
                &kp LA(BSPC), &kp LA(DEL), &kp LG(BSPC), &kp LG(DEL), ___,
                ___, ___, ___, ___, ___,
                &kp DEL
            )
            >;
        };

        // =====================================================================
        // RUSSIAN — Vestnik (Вестник), toggle via tap RCTRL (hold = RCtrl)
        //   ц д р г х  ф п а я э  .
        //   с т н к б  ь в о е и  ,
        //   ш з л м ч  ж й ы у ю
        // Extras: RIGHT щ | UP ъ | DOWN ё | BSPC-thumb ́ | [ « | ] »
        // =====================================================================
        russian_layer {
            bindings = <
            &trans         &trans       &trans      &trans      &trans                                                                                         &trans  &trans      &trans      &trans      &trans
            &trans         &trans       &trans      &trans      &trans      &trans                                                                     &trans  &trans  &trans      &trans      &trans      &trans
            &trans         &mm_ru_tse   &mm_ru_de   &mm_ru_er   &mm_ru_ge   &mm_ru_ha                                                                  &mm_ru_ef &mm_ru_pe &mm_ru_a &mm_ru_ya &mm_ru_e &mm_ru_dot
            &trans         &mm_ru_es    &mm_ru_te   &mm_ru_en   &mm_ru_ka   &mm_ru_be                                                                  &mm_ru_soft &mm_ru_ve &mm_ru_o &mm_ru_ye &mm_ru_i &mm_ru_comma
            &trans         &mm_ru_sha   &mm_ru_ze   &mm_ru_el   &mm_ru_em   &mm_ru_che &trans &trans &trans  &trans  &ru_tog RCTRL DEFAULT &trans   &mm_ru_zhe &mm_ru_short_i &mm_ru_yery &mm_ru_u &mm_ru_yu &trans
            &trans         &trans       &trans      &trans      &mm_ru_shcha               &m_ru_stress &trans &trans &trans &trans &trans &mm_ru_hard &mm_ru_yo &m_ru_laquo &m_ru_raquo &trans
            >;
        };

        // =====================================================================
        // MAGIC — Bluetooth / RGB / bootloader (stock Glove80)
        // =====================================================================
        magic_layer {
            bindings = <
&bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
&none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
&none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
&bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
&sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
&none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
&kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
&kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
&kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
&kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
&kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
&kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
