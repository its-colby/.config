/*
 * Glove80 keymap — firmware Graphite alphas (HID letter codes).
 *
 * macOS input source must stay US/QWERTY. Do NOT enable an OS Graphite layout
 * (it would double-map Glove80). Mac builtin Graphite is done in Goku/Karabiner
 * with :is_built_in_keyboard only.
 *
 * Shared actions (apps, window mgmt) emit chords; Hammerspoon runs the scripts.
 * Karabiner must not handle Glove80.
 *
 * Unicode macros use macOS Unicode Hex Input for math/logic paste keys.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#include "layout_helpers.dtsi"

// Layer indices — LOWER/MAGIC/FACTORY keep stock roles
#define DEFAULT 0
#define LOWER   1
#define L_W     2   // Graphite W — Dual punctuation (phys R)
#define L_F     3   // Graphite F — Solo punctuation (phys U)
#define L_D     4   // Graphite D — Math relations (phys E)
#define L_O     5   // Graphite O — Math operators (phys I)
#define L_L     6   // Graphite L — Logic symbols (phys W)
#define L_U     7   // Graphite U — Misc punctuation (phys O)
#define L_N     8   // Graphite N — Find & navigate (phys A)
#define L_R     9   // Graphite R — Text selection (phys S)
#define L_T     10  // Graphite T — Browser (phys D)
#define L_S     11  // Graphite S — Secondary apps (phys F)
#define L_H     12  // Graphite H — Primary apps (phys J)
#define L_A     13  // Graphite A — Inner app nav (phys K)
#define L_E     14  // Graphite E — Clipboard & edit (phys L)
#define L_I     15  // Graphite I — Window management (phys SEMI)
#define L_AUDIO 16  // Caps hold — Audio & display
#define L_WDEL  17  // Space hold — Word deletion
#define L_WNAV  18  // Enter hold — Word navigation
#define MAGIC   19
#define FACTORY_TEST 20

// Built-in layer-tap (&lt): hold → momentary layer, tap → key.
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
    quick-tap-ms = <400>;
};

/ {
    behaviors {
        // Stock Lower: hold = momentary, double-tap = toggle
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LOWER>, <&to LOWER>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        // Base punctuation (shift morphs). Physical positions as specified.
        mm_y: mod_morph_y {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_m: mod_morph_m {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_comma: mod_morph_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_dot: mod_morph_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_sqt: mod_morph_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_bslh: mod_morph_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        // Dual punctuation wrappers (type pair, cursor between)
        WRAP(m_parens,   LPAR,  RPAR);
        WRAP(m_brackets, LBKT,  RBKT);
        WRAP(m_braces,   LBRC,  RBRC);
        WRAP(m_dquote,   DQT,   DQT);
        WRAP(m_squote,   SQT,   SQT);
        WRAP(m_grave,    GRAVE, GRAVE);
        UC2_LEFT(m_angles, N2, N7, E, N8, N2, N7, E, N9); // ⟨⟩ then Left

        // macOS Unicode Hex Input (Option + 4 hex digits)
        UC(m_equiv,     N2, N2, N6, N1); // ≡
        UC(m_nequiv,    N2, N2, N6, N2); // ≢
        UC(m_sim,       N2, N2, N3, C);  // ∼
        UC(m_in,        N2, N2, N0, N8); // ∈
        UC(m_notin,     N2, N2, N0, N9); // ∉
        UC(m_subseteq,  N2, N2, N8, N6); // ⊆
        UC(m_supseteq,  N2, N2, N8, N7); // ⊇
        UC(m_nsubset,   N2, N2, N8, N4); // ⊄
        UC(m_nsuperset, N2, N2, N8, N5); // ⊅
        UC(m_circ,      N2, N2, N1, N8); // ∘
        UC(m_mapsto,    N2, N1, A,  N6); // ↦
        UC(m_times,     N0, N0, D,  N7); // ×
        UC(m_oplus,     N2, N2, N9, N5); // ⊕
        UC(m_otimes,    N2, N2, N9, N7); // ⊗
        UC(m_odot,      N2, N2, N9, N9); // ⊙
        UC(m_rarr,      N2, N1, N9, N2); // →
        UC(m_larr,      N2, N1, N9, N0); // ←
        UC(m_uarr,      N2, N1, N9, N1); // ↑
        UC(m_darr,      N2, N1, N9, N3); // ↓
        UC(m_land,      N2, N2, N2, N7); // ∧
        UC(m_lor,       N2, N2, N2, N8); // ∨
        UC(m_exists,    N2, N2, N0, N3); // ∃
        UC(m_forall,    N2, N2, N0, N0); // ∀
        UC(m_implies,   N2, N7, F,  N9); // ⟹
        UC(m_iff,       N2, N7, F,  A);  // ⟺
        UC(m_vdash,     N2, N2, A,  N2); // ⊢
        UC(m_models,    N2, N2, A,  N8); // ⊨
        UC(m_top,       N2, N2, A,  N4); // ⊤
        UC(m_bot,       N2, N2, A,  N5); // ⊥
        UC(m_therefore, N2, N2, N3, N4); // ∴
        UC(m_inf,       N2, N2, N1, E);  // ∞
        UC(m_emptyset,  N2, N2, N0, N5); // ∅
        UC(m_leq,       N2, N2, N6, N4); // ≤
        UC(m_geq,       N2, N2, N6, N5); // ≥
        UC(m_neq,       N2, N2, N6, N0); // ≠
        UC(m_middot,    N0, N0, B,  N7); // ·
        UC(m_pm,        N0, N0, B,  N1); // ±
        UC(m_not,       N0, N0, A,  C);  // ¬
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // DEFAULT — Graphite letter HID (OS must be US/QWERTY)
        //   b l d w z  , f o u j  \
        //   n r t s g  y h a e i  '
        //   q x m c v  k p . - /
        // =====================================================================
        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
            // |  TAB  |  B  |  L  |  D   |  W   |  Z   |                                                 |  ,   |   F   |   O   |  U   |   J   |   \  |
            // |  ESC  |  N  |  R  |  T   |  S   |  G   |                                                 |  Y   |   H   |   A   |  E   |   I   |   '  |
            // |   `   |  Q  |  X  |  M   |  C   |  V   | LSHFT | LCTRL | LOWER | | LGUI  | RCTRL | RSHFT |  K   |   .   |   -   |  ;   |   /   | PGUP |
            // | MAGIC | HOME| END | LEFT | RIGHT|      | TAB   | CAPS  | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

            bindings = <
            &kp F1         &kp F2   &kp F3      &kp F4      &kp F5                                                                                         &kp F6  &kp F7      &kp F8      &kp F9      &kp F10
            &kp EQUAL      &kp N1   &kp N2      &kp N3      &kp N4      &kp N5                                                                     &kp N6  &kp N7  &kp N8      &kp N9      &kp N0      &kp MINUS
            &kp TAB        &kp B    &lt L_L L   &lt L_D D   &lt L_W W   &kp Z                                                                      &mm_y   &lt L_F F  &lt L_O O  &lt L_U U  &kp J       &mm_bslh
            &kp ESC        &lt L_N N &lt L_R R  &lt L_T T   &lt L_S S   &kp G                                                                      &kp Y   &lt L_H H  &lt L_A A  &lt L_E E  &lt L_I I   &mm_sqt
            &kp GRAVE      &kp Q    &kp X       &kp M       &kp C       &kp V   &kp LSHFT   &kp LCTRL   &layer_td  &kp LGUI  &kp RCTRL &kp RSHFT   &kp K   &mm_m   &mm_comma   &mm_dot     &kp FSLH    &kp PG_UP
            &magic MAGIC 0 &kp HOME &kp END     &kp LEFT    &kp RIGHT          &kp TAB     &lt L_AUDIO CAPS &kp LALT &kp RALT &lt L_WNAV RET &lt L_WDEL SPACE &kp UP &kp DOWN &kp LBKT &kp RBKT &kp PG_DN
            >;
        };

        // Stock Lower layer (unchanged from MoErgo default)
        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                           &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none           &kp PAUSE_BREAK
            &trans            &none               &none           &none           &none           &kp HOME                                                                              &kp LPAR     &kp KP_NUM   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                               &kp RPAR     &kp KP_N7    &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                             &kp PRCNT    &kp KP_N4    &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN       &trans      &trans      &to DEFAULT &trans      &trans      &trans    &kp COMMA    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                         &trans      &trans      &trans      &trans      &trans      &trans                 &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER    &trans
            >;
        };

        // =====================================================================
        // Layers — opposite-hand only via LAYER_LEFT / LAYER_RIGHT
        // Args are QWERTY positions; comments note Graphite roles.
        // LAYER_RIGHT(y,u,i,o,p,  h,j,k,l,;,  n,m,,,.,/,  space)
        // LAYER_LEFT (q,w,e,r,t,  a,s,d,f,g,  z,x,c,v,b,  space)
        // =====================================================================

        // Graphite W (phys R) — Dual punctuation
        layer_w {
            bindings = <
            LAYER_RIGHT(
                ___, ___, ___, ___, ___,
                ___, &m_dquote, &kp DQT, &m_squote, &kp SQT,
                &m_grave, &m_parens, &m_brackets, &m_braces, &m_angles,
                ___
            )
            >;
        };

        // Graphite F (phys U) — Solo punctuation
        layer_f {
            bindings = <
            LAYER_LEFT(
                &kp PLUS, &kp STAR, &kp HASH, &kp BSLH, &kp MINUS,
                &kp PIPE, &kp EQUAL, &kp MINUS, &kp UNDER, ___,
                &kp MINUS, &kp TILDE, &kp PRCNT, &kp CARET, &kp AMPS,
                ___
            )
            >;
        };

        // Graphite D (phys E) — Math relations
        layer_d {
            bindings = <
            LAYER_RIGHT(
                &m_nsuperset, &m_in, &m_notin, &m_subseteq, &m_supseteq,
                ___, &m_nsubset, &m_leq, &m_geq, &kp LT,
                &m_sim, &kp EQUAL, &m_neq, &m_equiv, &m_nequiv,
                ___
            )
            >;
        };

        // Graphite O (phys I) — Math operators
        layer_o {
            bindings = <
            LAYER_LEFT(
                &kp MINUS, &m_times, &m_oplus, &m_otimes, &m_odot,
                &m_mapsto, &kp PLUS, &m_middot, &m_circ, &m_pm,
                &kp MINUS, &m_rarr, &m_larr, &m_uarr, &m_darr,
                ___
            )
            >;
        };

        // Graphite L (phys W) — Logic symbols
        layer_l {
            bindings = <
            LAYER_RIGHT(
                &m_top, &m_bot, &m_therefore, &m_models, ___,
                ___, ___, &m_implies, &m_iff, &m_vdash,
                &m_not, &m_land, &m_lor, &m_exists, &m_forall,
                ___
            )
            >;
        };

        // Graphite U (phys O) — Misc punctuation
        layer_u {
            bindings = <
            LAYER_LEFT(
                &kp SEMI, &kp EXCL, &kp QMARK, &kp DLLR, &kp FSLH,
                &m_inf, &m_emptyset, &m_pm, &m_models, ___,
                &m_top, &m_bot, &m_therefore, ___, ___,
                ___
            )
            >;
        };

        // Graphite N (phys A) — Find & navigate
        layer_n {
            bindings = <
            LAYER_RIGHT(
                &kp LG(F), &kp LG(LA(F)), &kp LG(G), &kp LG(LS(G)), &kp F2,
                ___, &kp TAB, &kp LS(TAB), &kp LG(S), &kp ESC,
                ___, ___, ___, ___, ___,
                &kp LS(LG(LA(M)))
            )
            >;
        };

        // Graphite R (phys S) — Text selection
        layer_r {
            bindings = <
            LAYER_RIGHT(
                &kp LS(UP), &kp LS(DOWN), &kp LS(RIGHT), &kp LS(LEFT), ___,
                ___, &kp LS(LA(RIGHT)), &kp LS(LA(LEFT)), &kp LS(LG(RIGHT)), &kp LS(LG(LEFT)),
                ___, ___, ___, ___, ___,
                &kp LG(A)
            )
            >;
        };

        // Graphite T (phys D) — Browser navigation
        layer_t {
            bindings = <
            LAYER_RIGHT(
                &kp LG(LBKT), &kp LG(RBKT), &kp LC(LA(E)), ___, ___,
                ___, &kp LC(LA(G)), &kp LC(LA(F)), &kp LC(LA(D)), &kp LC(LA(Q)),
                ___, ___, ___, ___, ___,
                &kp LC(LA(W))
            )
            >;
        };

        // Graphite S (phys F) — Secondary apps (Arc via hyper chords; Karabiner/HS handles)
        layer_s {
            bindings = <
            LAYER_RIGHT(
                &kp HYPER(Q), &kp HYPER(W), &kp HYPER(E), &kp HYPER(R), ___,
                ___, &kp HYPER(T), &kp HYPER(Y), &kp HYPER(U), &kp HYPER(I),
                &kp HYPER(O), &kp HYPER(P), ___, ___, ___,
                ___
            )
            >;
        };

        // Graphite H (phys J) — Primary apps
        layer_h {
            bindings = <
            LAYER_LEFT(
                ___, ___, ___, ___, ___,
                &kp HYPER(N1), &kp HYPER(N2), &kp HYPER(N3), &kp HYPER(N4), ___,
                ___, ___, ___, ___, ___,
                &kp LS(LA(SPACE))
            )
            >;
        };

        // Graphite A (phys K) — Inner application navigation
        layer_a {
            bindings = <
            LAYER_LEFT(
                &kp PG_UP, &kp PG_DN, &kp HOME, &kp END, ___,
                &kp LG(LA(J)), &kp LG(J), &kp LG(B), &kp LG(LA(B)), ___,
                ___, ___, &kp LG(EQUAL), &kp LG(MINUS), ___,
                ___
            )
            >;
        };

        // Graphite E (phys L) — Clipboard & edit
        layer_e {
            bindings = <
            LAYER_LEFT(
                ___, ___, &kp LG(LS(V)), &kp LG(LS(Z)), ___,
                &kp LG(C), &kp LG(X), &kp LG(V), &kp LG(Z), ___,
                ___, ___, ___, ___, ___,
                &kp LG(FSLH)
            )
            >;
        };

        // Graphite I — Window management (Alt+Shift → Aerospace)
        // L=focus left, D/W=resize, N=swap, R=float, T=accordion, S=tiles/split, Space=focus right
        layer_i {
            bindings = <
            LAYER_LEFT(
                ___, &kp LS(LA(D)), &kp LS(LA(C)), &kp LS(LA(V)), ___,
                &kp LS(LA(A)), &kp LS(LA(S)), &kp LS(LA(Q)), &kp LS(LA(W)), ___,
                ___, ___, ___, ___, ___,
                &kp LS(LA(F))
            )
            >;
        };

        // Caps hold — Audio & display (left-hand Graphite keys; thumb free)
        layer_audio {
            bindings = <
            LAYER_LEFT(
                ___, &kp LG(L), ___, ___, ___,
                &kp C_MUTE, &kp C_VOL_UP, &kp C_VOL_DN, &kp C_BRI_UP, ___,
                &kp C_BRI_DN, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // Space hold — Word deletion
        layer_wdel {
            bindings = <
            LAYER_LEFT(
                &kp LS(RET), &kp LG(DEL), &kp LG(BSPC), &kp LG(RBKT), &kp LG(LBKT),
                &kp BSPC, &kp LA(BSPC), &kp LA(DEL), ___, ___,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // Enter hold — Word navigation
        layer_wnav {
            bindings = <
            LAYER_LEFT(
                ___, &kp RIGHT, &kp LEFT, &kp UP, &kp DOWN,
                &kp LA(LEFT), &kp LA(RIGHT), &kp LG(RIGHT), &kp LG(LEFT), ___,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };

        // =====================================================================
        // MAGIC — Bluetooth / RGB / bootloader (stock Glove80)
        // =====================================================================
        magic_layer {
            bindings = <
&bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
&none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
&none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
&bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
&sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
&none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
&kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
&kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
&kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
&kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
&kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
&kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
