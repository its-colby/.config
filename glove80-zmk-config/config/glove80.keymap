/*
 * Glove80 keymap: Graphite alphas + Goku letter simlayers.
 * Only letter (and former letter) keys use hold-to-layer via &lt.
 * Escape, Tab, thumbs, mods, Magic, Lower stay stock; punct mostly stock
 * except Graphite comma / . / - placement.
 *
 * Unicode paste macros (⟨⟩, ≡, ∈, …) use macOS Unicode Hex Input
 * (hold Option, type hex, release). Enable that input source for those keys.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#include "layout_helpers.dtsi"

// Layer indices — LOWER/MAGIC/FACTORY keep stock roles; Goku layers in between
#define DEFAULT 0
#define LOWER   1
#define L_F     2   // f-text-editing
#define L_D     3   // d-dual-punctuation
#define L_S     4   // s-solo-punctuation
#define L_A     5   // a-6-through-0
#define L_R     6   // r-recording
#define L_V     7   // v-relations
#define L_C     8   // c-operators
#define L_X     9   // x-logic
#define L_G     10  // g-left-shift
#define L_J     11  // j-text-navigation
#define L_K     12  // k-tab-navigation
#define L_L     13  // l-window-navigation
#define L_SEMI  14  // semicolon-1-through-5 (Goku; hold ; tap types ;)
#define L_U     15  // u-file-navigation
#define L_I     16  // i-text-selection
#define L_O     17  // o-audio-visual
#define L_H     18  // h-right-shift
#define MAGIC   19
#define FACTORY_TEST 20

// Built-in layer-tap (&lt): hold → momentary layer, tap → key.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        // Stock Lower: hold = momentary, double-tap = toggle
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LOWER>, <&to LOWER>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        // Dual punctuation wrappers (type pair, cursor between)
        WRAP(m_parens,   LPAR,  RPAR);
        WRAP(m_brackets, LBKT,  RBKT);
        WRAP(m_braces,   LBRC,  RBRC);
        WRAP(m_dquote,   DQT,   DQT);
        WRAP(m_squote,   SQT,   SQT);
        WRAP(m_grave,    GRAVE, GRAVE);
        UC2_LEFT(m_angles, N2, N7, E, N8, N2, N7, E, N9); // ⟨⟩ then Left

        // macOS Unicode Hex Input (Option + 4 hex digits)
        UC(m_equiv,     N2, N2, N6, N1); // ≡
        UC(m_nequiv,    N2, N2, N6, N2); // ≢
        UC(m_sim,       N2, N2, N3, C);  // ∼
        UC(m_in,        N2, N2, N0, N8); // ∈
        UC(m_notin,     N2, N2, N0, N9); // ∉
        UC(m_subseteq,  N2, N2, N8, N6); // ⊆
        UC(m_supseteq,  N2, N2, N8, N7); // ⊇
        UC(m_nsubset,   N2, N2, N8, N4); // ⊄
        UC(m_nsuperset, N2, N2, N8, N5); // ⊅
        UC(m_circ,      N2, N2, N1, N8); // ∘
        UC(m_mapsto,    N2, N1, A,  N6); // ↦
        UC(m_times,     N0, N0, D,  N7); // ×
        UC(m_oplus,     N2, N2, N9, N5); // ⊕
        UC(m_otimes,    N2, N2, N9, N7); // ⊗
        UC(m_odot,      N2, N2, N9, N9); // ⊙
        UC(m_rarr,      N2, N1, N9, N2); // →
        UC(m_larr,      N2, N1, N9, N0); // ←
        UC(m_uarr,      N2, N1, N9, N1); // ↑
        UC(m_darr,      N2, N1, N9, N3); // ↓
        UC(m_land,      N2, N2, N2, N7); // ∧
        UC(m_lor,       N2, N2, N2, N8); // ∨
        UC(m_exists,    N2, N2, N0, N3); // ∃
        UC(m_forall,    N2, N2, N0, N0); // ∀
        UC(m_implies,   N2, N7, F,  N9); // ⟹
        UC(m_iff,       N2, N7, F,  A);  // ⟺
        UC(m_vdash,     N2, N2, A,  N2); // ⊢
        UC(m_models,    N2, N2, A,  N8); // ⊨
        UC(m_top,       N2, N2, A,  N4); // ⊤
        UC(m_bot,       N2, N2, A,  N5); // ⊥
        UC(m_therefore, N2, N2, N3, N4); // ∴
        UC(m_inf,       N2, N2, N1, E);  // ∞
        UC(m_emptyset,  N2, N2, N0, N5); // ∅
        UC(m_leq,       N2, N2, N6, N4); // ≤
        UC(m_geq,       N2, N2, N6, N5); // ≥
        UC(m_neq,       N2, N2, N6, N0); // ≠
        UC(m_middot,    N0, N0, B,  N7); // ·
        UC(m_pm,        N0, N0, B,  N1); // ±
        UC(m_not,       N0, N0, A,  C);  // ¬
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // DEFAULT — Graphite alphas; Goku holds on same physical keys
        //   b l d w z  , f o u j  \     |  n r t s g  y h a e i  '
        //   q x m c v  k p . - /
        // =====================================================================
        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |                                                               |  F6   |  F7   |  F8  |   F9  |  F10 |
            // |  =    |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   |   -  |
            // |  TAB  |  B  |  L  |  D   |  W   |  Z   |                                                 |  ,   |   F   |   O   |  U   |   J   |   \  |
            // |  ESC  |  N  |  R  |  T   |  S   |  G   |                                                 |  Y   |   H   |   A   |  E   |   I   |   '  |
            // |   `   |  Q  |  X  |  M   |  C   |  V   | LSHFT | LCTRL | LOWER | | LGUI  | RCTRL | RSHFT |  K   |   P   |   .   |  -   |   /   | PGUP |
            // | MAGIC | HOME| END | LEFT | RIGHT|      | BSPC  | DEL   | LALT  | | RALT  | RET   | SPACE |      |  UP   | DOWN  |  [   |   ]   | PGDN |

            bindings = <
            &kp F1         &kp F2   &kp F3      &kp F4      &kp F5                                                                                         &kp F6  &kp F7      &kp F8      &kp F9      &kp F10
            &kp EQUAL      &kp N1   &kp N2      &kp N3      &kp N4      &kp N5                                                                     &kp N6  &kp N7  &kp N8      &kp N9      &kp N0      &kp MINUS
            &kp TAB        &kp B    &kp L       &kp D       &lt L_R W  &kp Z                                                                      &kp COMMA &lt L_U F &lt L_I O &lt L_O U &kp J       &kp BSLH
            &kp ESC        &lt L_A N &lt L_S R &lt L_D T &lt L_F S  &lt L_G G                                                                 &lt L_H Y &lt L_J H &lt L_K A &lt L_L E &lt L_SEMI I &kp SQT
            &kp GRAVE      &kp Q    &lt L_X X  &lt L_C M  &lt L_V C  &kp V   &kp LSHFT   &kp LCTRL   &layer_td  &kp LGUI  &kp RCTRL &kp RSHFT   &kp K   &kp P   &kp DOT     &kp MINUS   &kp FSLH    &kp PG_UP
            &magic MAGIC 0 &kp HOME &kp END     &kp LEFT    &kp RIGHT          &kp BSPC    &kp DEL     &kp LALT   &kp RALT  &kp RET   &kp SPACE           &kp UP  &kp DOWN    &kp LBKT    &kp RBKT    &kp PG_DN
            >;
        };

        // Stock Lower layer (unchanged from MoErgo default)
        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                           &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none           &kp PAUSE_BREAK
            &trans            &none               &none           &none           &none           &kp HOME                                                                              &kp LPAR     &kp KP_NUM   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                               &kp RPAR     &kp KP_N7    &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                             &kp PRCNT    &kp KP_N4    &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN       &trans      &trans      &to DEFAULT &trans      &trans      &trans    &kp COMMA    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                         &trans      &trans      &trans      &trans      &trans      &trans                 &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER    &trans
            >;
        };

        // =====================================================================
        // Goku layers — only opposite-hand keys; rest is ___ via helpers
        // LAYER_RIGHT(y,u,i,o,p,  h,j,k,l,;,  n,m,,,.,/,  space)
        // LAYER_LEFT (q,w,e,r,t,  a,s,d,f,g,  z,x,c,v,b,  space)
        // =====================================================================


        layer_f {
            bindings = <
            LAYER_RIGHT(
                ___, &kp LG(LBKT), &kp LG(RBKT), ___, ___,
                ___, &kp BSPC, &kp RET, &kp TAB, &kp LS(RET),
                &kp DEL, &kp LA(BSPC), &kp LA(DEL), &kp LG(BSPC), &kp LG(DEL),
                ___
            )
            >;
        };


        layer_d {
            bindings = <
            LAYER_RIGHT(
                &m_dquote, &kp DQT, &m_squote, &kp SQT, ___,
                &m_grave, &m_parens, &m_brackets, &m_braces, &m_angles,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };


        layer_s {
            bindings = <
            LAYER_RIGHT(
                &kp PLUS, &kp STAR, &kp HASH, &kp BSLH, ___,
                &kp PIPE, &kp EQUAL, &kp MINUS, &kp UNDER, &kp FSLH,
                ___, &kp TILDE, &kp PRCNT, &kp CARET, &kp AMPS,
                ___
            )
            >;
        };


        layer_a {
            bindings = <
            LAYER_RIGHT(
                &m_inf, &m_emptyset, ___, ___, ___,
                &kp N6, &kp N7, &kp N8, &kp N9, &kp N0,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };


        layer_r {
            bindings = <
            LAYER_RIGHT(
                ___, ___, ___, ___, ___,
                ___, &kp LC(LA(A)), &kp LC(LA(B)), &kp F13, &kp LC(LA(D)),
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };


        layer_v {
            bindings = <
            LAYER_RIGHT(
                &m_nsubset, &m_leq, &m_geq, &kp LT, &kp GT,
                &m_sim, &kp EQUAL, &m_neq, &m_equiv, &m_nequiv,
                &m_nsuperset, &m_in, &m_notin, &m_subseteq, &m_supseteq,
                ___
            )
            >;
        };


        layer_c {
            bindings = <
            LAYER_RIGHT(
                ___, &m_times, &m_oplus, &m_otimes, &m_odot,
                &m_mapsto, &kp PLUS, &m_middot, &m_circ, &m_pm,
                ___, &m_rarr, &m_larr, &m_uarr, &m_darr,
                ___
            )
            >;
        };


        layer_x {
            bindings = <
            LAYER_RIGHT(
                ___, &m_implies, &m_iff, &m_vdash, &m_models,
                &m_not, &m_land, &m_lor, &m_exists, &m_forall,
                ___, &m_top, &m_bot, &m_therefore, ___,
                ___
            )
            >;
        };


        layer_g {
            bindings = <
            LAYER_RIGHT(
                &kp LS(COMMA), &kp LS(F), &kp LS(O), &kp LS(U), &kp LS(J),
                &kp LS(Y), &kp LS(H), &kp LS(A), &kp LS(E), &kp LS(I),
                &kp LS(K), &kp LS(P), &kp LS(DOT), &kp LS(MINUS), &kp LS(FSLH),
                ___
            )
            >;
        };


        layer_j {
            bindings = <
            LAYER_LEFT(
                &kp LG(LEFT), &kp LG(RIGHT), &kp LA(LEFT), &kp LA(RIGHT), ___,
                &kp DOWN, &kp UP, &kp LEFT, &kp RIGHT, ___,
                &kp LS(LA(LC(Z))), &kp LS(LA(LC(X))), &kp LC(LA(EQUAL)), &kp LS(LA(LC(V))), ___,
                ___
            )
            >;
        };


        layer_k {
            bindings = <
            LAYER_LEFT(
                &kp LG(LBKT), &kp LG(RBKT), &kp LC(LA(E)), &kp LC(LA(R)), &kp LC(LA(Q)),
                &kp LC(LA(A)), &kp LC(LA(S)), &kp LC(LA(D)), &kp LC(LA(F)), &kp LC(LA(G)),
                &kp END, &kp HOME, &kp PG_DN, &kp PG_UP, ___,
                &kp LC(LA(W))
            )
            >;
        };


        layer_l {
            bindings = <
            LAYER_LEFT(
                &kp LS(LA(Q)), &kp LS(LA(W)), &kp LS(LA(E)), &kp LS(LA(R)), ___,
                &kp LS(LA(A)), &kp LS(LA(S)), &kp LS(LA(D)), &kp LS(LA(F)), ___,
                ___, ___, &kp LS(LA(C)), &kp LS(LA(V)), ___,
                &kp LS(LA(SPACE))
            )
            >;
        };


        layer_semi {
            bindings = <
            LAYER_LEFT(
                ___, ___, ___, ___, ___,
                &kp N1, &kp N2, &kp N3, &kp N4, &kp N5,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };


        layer_u {
            bindings = <
            LAYER_LEFT(
                &kp LG(LS(G)), &kp LG(G), &kp LG(LA(F)), &kp LG(F), ___,
                &kp LS(TAB), &kp TAB, &kp LG(LS(Z)), &kp LG(Z), &kp F2,
                ___, ___, &kp ESC, &kp LG(S), ___,
                &kp LS(LG(LA(M)))
            )
            >;
        };


        layer_i {
            bindings = <
            LAYER_LEFT(
                &kp LS(DOWN), &kp LS(UP), &kp LS(LEFT), &kp LS(RIGHT), ___,
                &kp LS(LG(LEFT)), &kp LS(LG(RIGHT)), &kp LS(LA(LEFT)), &kp LS(LA(RIGHT)), &kp LG(A),
                &kp LG(LS(V)), &kp LG(C), &kp LG(X), &kp LG(V), ___,
                &kp LG(FSLH)
            )
            >;
        };


        layer_o {
            bindings = <
            LAYER_LEFT(
                ___, ___, ___, &kp LG(L), ___,
                &kp C_BRI_DN, &kp C_BRI_UP, &kp C_VOL_DN, &kp C_VOL_UP, &kp C_MUTE,
                ___, ___, ___, ___, ___,
                ___
            )
            >;
        };


        layer_h {
            bindings = <
            LAYER_LEFT(
                &kp LS(B), &kp LS(L), &kp LS(D), &kp LS(W), &kp LS(Z),
                &kp LS(N), &kp LS(R), &kp LS(T), &kp LS(S), &kp LS(G),
                &kp LS(Q), &kp LS(X), &kp LS(M), &kp LS(C), &kp LS(V),
                ___
            )
            >;
        };

        // =====================================================================
        // MAGIC — Bluetooth / RGB / bootloader (stock Glove80)
        // =====================================================================
        magic_layer {
            bindings = <
&bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
&none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
&none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
&bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
&sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
&none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
&kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
&kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
&kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
&kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
&kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
&kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
