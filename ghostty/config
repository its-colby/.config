# ── Typography ───────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font Mono
font-size = 22
font-thicken = true

# ── Tokyo Night (minimal, high-contrast) ─────────────────────────────────────
background = #1a1b26
foreground = #c0caf5
cursor-color = #7aa2f7
cursor-text = #1a1b26
selection-background = #33467c
selection-foreground = #c0caf5

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# ── Glassy window ────────────────────────────────────────────────────────────
background-opacity = 0.88
background-blur = true
background-opacity-cells = true

# ── Insets (left, top only — values are points, scaled for DPI) ──────────────
window-padding-x = 16,0
window-padding-y = 16,0
window-padding-balance = false
window-padding-color = background

# ── Cursor & shell integration ───────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
shell-integration-features = cursor,sudo,title

# ── macOS chrome ─────────────────────────────────────────────────────────────
macos-titlebar-style = transparent
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
title = " "

# ── Keyboard-first workflow ──────────────────────────────────────────────────
# Discover everything: Cmd+Shift+P
keybind = cmd+shift+p=toggle_command_palette

# Send Cmd shortcuts as ESC-prefixed Meta keys so tmux can read M-t/M-w/M-[/M-]
keybind = cmd+t=text:\x1bt
keybind = cmd+w=text:\x1bw
keybind = cmd+shift+left_bracket=text:\x1b[
keybind = cmd+shift+right_bracket=text:\x1b]
keybind = super+t=text:\x1bt
keybind = super+w=text:\x1bw
keybind = super+shift+left_bracket=text:\x1b[
keybind = super+shift+right_bracket=text:\x1b]

# Windows & tabs
# NOTE: these are intentionally moved off the standard macOS bindings so that
# Karabiner/Goku (and tmux) can use Cmd+T/Cmd+W/Cmd+Shift+[/] without Ghostty
# intercepting them.
keybind = cmd+alt+shift+n=new_window
keybind = cmd+alt+shift+t=new_tab
keybind = cmd+alt+shift+w=close_surface
keybind = cmd+alt+shift+left_bracket=previous_tab
keybind = cmd+alt+shift+right_bracket=next_tab

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Font size (fine-tune without editing config)
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Quick actions
keybind = cmd+k=clear_screen
keybind = cmd+shift+r=reload_config
keybind = cmd+grave_accent=toggle_quick_terminal

# Vim-style escape sequences (your existing bindings)
keybind = cmd+left_bracket=text:\x1b[
keybind = cmd+right_bracket=text:\x1b]

# ── Command palette: built-in help ───────────────────────────────────────────
command-palette-entry = title:Keyboard Cheatsheet, description:Show shortcuts in the terminal, action:text:\x1bh\x0d
command-palette-entry = title:Reload Config, description:Apply ghostty/config changes, action:reload_config
command-palette-entry = title:New Tab, description:Open a new tab, action:new_tab
command-palette-entry = title:Split Right, description:Split pane to the right, action:new_split:right
command-palette-entry = title:Quick Terminal, description:Toggle dropdown terminal, action:toggle_quick_terminal
