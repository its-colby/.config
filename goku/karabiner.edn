{
    :profiles {
        :Default {
            :default true
            :sim     200
            :delay   300
            :alone   400
            :held    400
        }
    }

    :templates {
        :paste "osascript -e '
        set prev to the clipboard
        set the clipboard to \"%s\"
        tell application \"System Events\"
            keystroke \"v\" using command down
            delay 0.1
        end tell
        set the clipboard to prev
        '"
        :paste-left "osascript -e '
        set prev to the clipboard
        set the clipboard to \"%s\"
        tell application \"System Events\"
            keystroke \"v\" using command down
            key code 123
            delay 0.1
        end tell
        set the clipboard to prev
        '"
   }

    :devices {
        :builtin [{:is_built_in_keyboard true}]
    }

    ; Graphite letter → physical QWERTY (Karabiner keycodes):
    ; B→q L→w D→e W→r Z→t  ,→y F→u O→i U→o J→p
    ; N→a R→s T→d S→f G→g  Y→h H→j A→k E→l I→semicolon
    ; Q→z X→x M→c C→v V→b  K→n P→m .→comma -→period /→slash
    ; Simlayer :key is always the PHYSICAL key under the Graphite letter.
    :simlayers {
        ; ---------------------------------------
        ; ---------- Upper row (punct/math) -----
        ; ---------------------------------------
        :w-dual-punctuation {:key :r :condi :builtin}       ; Graphite W (phys r)
        :f-solo-punctuation {:key :u :condi :builtin}       ; Graphite F (phys u)
        :d-relations        {:key :e :condi :builtin}       ; Graphite D (phys e)
        :o-operators        {:key :i :condi :builtin}       ; Graphite O (phys i)
        :l-logic            {:key :w :condi :builtin}       ; Graphite L (phys w)
        :u-misc             {:key :o :condi :builtin}       ; Graphite U (phys o)

        ; ---------------------------------------
        ; ---------- Home row -------------------
        ; ---------------------------------------
        :n-find             {:key :a :condi :builtin}       ; Graphite N (phys a)
        :r-selection        {:key :s :condi :builtin}       ; Graphite R (phys s)
        :t-browser          {:key :d :condi :builtin}       ; Graphite T (phys d)
        :s-secondary-apps   {:key :f :condi :builtin}       ; Graphite S (phys f)
        :h-primary-apps     {:key :j :condi :builtin}       ; Graphite H (phys j)
        :a-inner-nav        {:key :k :condi :builtin}       ; Graphite A (phys k)
        :e-clipboard        {:key :l :condi :builtin}       ; Graphite E (phys l)
        :i-window-mgmt      {:key :semicolon :condi :builtin} ; Graphite I (phys ;)

        ; ---------------------------------------
        ; ---------- Thumb layers (phys keys) ---
        ; ---------------------------------------
        :b-audio            {:key :b :condi :builtin}       ; phys B — Audio (Graphite V)
        :n-word-deletion    {:key :n :condi :builtin}       ; phys N — Word Deletion (Graphite K)
        :m-word-navigation  {:key :m :condi :builtin}       ; phys M — Word Navigation (Graphite P)
    }

    :input-sources {
        :russian-phonetic {
            :input_source_id "^com\\.apple\\.keylayout\\.Russian-Phonetic$"
        }
        :us {
            :input_source_id "^com\\.apple\\.keylayout\\.US$"
        }
    }

    :main [
        ; NOTE: Graphite base remaps are at the END of :main so simlayer
        ; rules match first while a layer is held (Karabiner = first match wins).

        ; =======================================
        ; UPPER: W Dual Punctuation (phys r)
        ; =======================================
        {
            :des "w-dual-punctuation (Graphite W / phys r)"
            :rules [
                [:condi :w-dual-punctuation :builtin]

                ; Graphite H A E I
                [:j [:!Squote :!Squote :left_arrow]]              ; H = ""
                [:k :!Squote]                                     ; A = "
                [:l [:quote :quote :left_arrow]]                  ; E = ''
                [:semicolon :quote]                               ; I = '

                ; Graphite K P . - /
                [:n [
                    :grave_accent_and_tilde
                    :grave_accent_and_tilde
                    :left_arrow
                ]]                                                ; K = ``
                [:m [:!S9 :!S0 :left_arrow]]                      ; P = ()
                [:comma [:open_bracket :close_bracket :left_arrow]] ; . = []
                [:period [:!Sopen_bracket :!Sclose_bracket :left_arrow]] ; - = {}
                [:slash [:paste-left "⟨⟩"]]                        ; / = ⟨⟩
            ]
        }

        ; =======================================
        ; UPPER: F Solo Punctuation (phys u)
        ; =======================================
        {
            :des "f-solo-punctuation (Graphite F / phys u)"
            :rules [
                [:condi :f-solo-punctuation :builtin]

                ; Graphite B L D W Z
                [:q :!Sequal_sign]          ; B = +
                [:w :!S8]                   ; L = *
                [:e :!S3]                   ; D = #
                [:r :backslash]             ; W = \
                [:t :hyphen]                ; Z = -

                ; Graphite N R T S
                [:a :!Sbackslash]           ; N = |
                [:s :equal_sign]            ; R = =
                [:d :hyphen]                ; T = hyphen
                [:f :!Shyphen]              ; S = _

                ; Graphite Q X M C V
                [:z :hyphen]                ; Q = -
                [:x :!Sgrave_accent_and_tilde] ; X = ~
                [:c :!S5]                   ; M = %
                [:v :!S6]                   ; C = ^
                [:b :!S7]                   ; V = &
            ]
        }

        ; =======================================
        ; UPPER: D Math Relations (phys e)
        ; =======================================
        {
            :des "d-relations (Graphite D / phys e)"
            :rules [
                [:condi :d-relations :builtin]

                ; Graphite H A E I
                [:j [:paste "⊄"]]           ; H = ⊄
                [:k [:paste "≤"]]           ; A = ≤
                [:l [:paste "≥"]]           ; E = ≥
                [:semicolon [:paste "<"]]   ; I = <

                ; Graphite K P . - /
                [:n [:paste "∼"]]           ; K = ∼
                [:m :equal_sign]            ; P = =
                [:comma [:paste "≠"]]       ; . = ≠
                [:period [:paste "≡"]]      ; - = ≡
                [:slash [:paste "≢"]]       ; / = ≢

                ; further row: ⊅ ∈ ∉ ⊆ ⊇ (Graphite Q X M C V)
                [:z [:paste "⊅"]]           ; Q = ⊅
                [:x [:paste "∈"]]           ; X = ∈
                [:c [:paste "∉"]]           ; M = ∉
                [:v [:paste "⊆"]]           ; C = ⊆
                [:b [:paste "⊇"]]           ; V = ⊇
            ]
        }

        ; =======================================
        ; UPPER: O Math Operators (phys i)
        ; =======================================
        {
            :des "o-operators (Graphite O / phys i)"
            :rules [
                [:condi :o-operators :builtin]

                ; Graphite B L D W Z
                [:q :hyphen]                ; B = -
                [:w [:paste "×"]]           ; L = ×
                [:e [:paste "⊕"]]           ; D = ⊕
                [:r [:paste "⊗"]]           ; W = ⊗
                [:t [:paste "⊙"]]           ; Z = ⊙

                ; Graphite N R T S
                [:a [:paste "↦"]]           ; N = ↦
                [:s :!Sequal_sign]          ; R = +
                [:d [:paste "·"]]           ; T = ·
                [:f [:paste "∘"]]           ; S = ∘

                ; Graphite Q X M C V
                [:z :hyphen]                ; Q = -
                [:x [:paste "→"]]           ; X = →
                [:c [:paste "←"]]           ; M = ←
                [:v [:paste "↑"]]           ; C = ↑
                [:b [:paste "↓"]]           ; V = ↓

                ; ± on free key (Graphite G)
                [:g [:paste "±"]]           ; G = ±
            ]
        }

        ; =======================================
        ; UPPER: L Logic Symbols (phys w)
        ; =======================================
        {
            :des "l-logic (Graphite L / phys w)"
            :rules [
                [:condi :l-logic :builtin]

                ; Graphite H A E I
                [:j :hyphen]                ; H = -
                [:k [:paste "⟹"]]           ; A = ⟹
                [:l [:paste "⟺"]]           ; E = ⟺
                [:semicolon [:paste "⊢"]]   ; I = ⊢

                ; Graphite K P . - /
                [:n [:paste "¬"]]           ; K = ¬
                [:m [:paste "∧"]]           ; P = ∧
                [:comma [:paste "∨"]]       ; . = ∨
                [:period [:paste "∃"]]      ; - = ∃
                [:slash [:paste "∀"]]       ; / = ∀

                ; also ⊤ ⊥ ∴ ⊨ (Graphite Q X M J)
                [:z [:paste "⊤"]]           ; Q = ⊤
                [:x [:paste "⊥"]]           ; X = ⊥
                [:c [:paste "∴"]]           ; M = ∴
                [:p [:paste "⊨"]]           ; J = ⊨
            ]
        }

        ; =======================================
        ; UPPER: U Misc Punctuation (phys o)
        ; =======================================
        {
            :des "u-misc (Graphite U / phys o)"
            :rules [
                [:condi :u-misc :builtin]

                ; Graphite B L D W Z
                [:q :semicolon]             ; B = ;
                [:w :!S1]                   ; L = !
                [:e :!Sslash]               ; D = ?
                [:r :!S4]                   ; W = $
                [:t :slash]                 ; Z = /

                ; Graphite N R T S
                [:a [:paste "∞"]]           ; N = ∞
                [:s [:paste "∅"]]           ; R = ∅
                [:d [:paste "±"]]           ; T = ±
                [:f [:paste "⊨"]]           ; S = ⊨

                ; Graphite Q X M C V
                [:z [:paste "⊤"]]           ; Q = ⊤
                [:x [:paste "⊥"]]           ; X = ⊥
                [:c [:paste "∴"]]           ; M = ∴
                ; C / V unused (-)
            ]
        }

        ; =======================================
        ; HOME: N Find & Navigate (phys a)
        ; =======================================
        {
            :des "n-find (Graphite N / phys a)"
            :rules [
                [:condi :n-find :builtin]

                ; Graphite , F O U J
                [:y :!Cf]                   ; , = find (Cmd+F)
                [:u :!COf]                  ; F = find and replace (Cmd+Opt+F)
                [:i :!Cg]                   ; O = next find (Cmd+G)
                [:o :!CSg]                  ; U = prev find (Cmd+Shift+G)
                [:p :!Ff2]                  ; J = rename (F2)

                ; Graphite H A E I
                [:j :tab]                   ; H = Tab (next UI)
                [:k :!Stab]                 ; A = Shift+Tab (prev UI)
                [:l :!Cs]                   ; E = save (Cmd+S)
                [:semicolon :escape]        ; I = Escape

                ; Space: accept autocomplete
                [:spacebar :!SCOm]          ; Shift+Cmd+Opt+M
            ]
        }

        ; =======================================
        ; HOME: R Text Selection (phys s)
        ; =======================================
        {
            :des "r-selection (Graphite R / phys s)"
            :rules [
                [:condi :r-selection :builtin]

                ; Graphite , F O U
                [:y :!Sup_arrow]            ; , = select line up
                [:u :!Sdown_arrow]          ; F = select line down
                [:i :!Sright_arrow]         ; O = select char right
                [:o :!Sleft_arrow]          ; U = select char left

                ; Graphite H A E I
                [:j :!SOright_arrow]        ; H = select word right
                [:k :!SOleft_arrow]         ; A = select word left
                [:l :!SCright_arrow]        ; E = select to line end
                [:semicolon :!SCleft_arrow] ; I = select to line start

                ; Space: select all
                [:spacebar :!Ca]
            ]
        }

        ; =======================================
        ; HOME: T Browser Navigation (phys d)
        ; =======================================
        {
            :des "t-browser (Graphite T / phys d)"
            :rules [
                [:condi :t-browser :builtin]

                ; Graphite , F O
                [:y :!Copen_bracket]        ; , = prev link (Cmd+[)
                [:u :!Cclose_bracket]       ; F = next link (Cmd+])
                [:i :!TOe]                  ; O = split horizontal (Ctrl+Opt+E)

                ; Graphite H A E I
                [:j :!TOg]                  ; H = new tab (Ctrl+Opt+G)
                [:k :!TOf]                  ; A = next tab (Ctrl+Opt+F)
                [:l :!TOd]                  ; E = prev tab (Ctrl+Opt+D)
                [:semicolon :!TOq]          ; I = switch spaces (Ctrl+Opt+Q)

                ; Space: close tab
                [:spacebar :!TOw]           ; Ctrl+Opt+W
            ]
        }

        ; =======================================
        ; HOME: S Secondary Apps (phys f)
        ; Hyper chords for Hammerspoon (Ctrl+Opt+Cmd+Shift)
        ; =======================================
        {
            :des "s-secondary-apps (Graphite S / phys f) — Arc URLs via hyper"
            :rules [
                [:condi :s-secondary-apps :builtin]

                ; Graphite , F O U → hyper+q/w/e/r
                [:y :!CTOSq]                ; , = WhatsApp (Arc) → hyper+q
                [:u :!CTOSw]                ; F = GitHub (Arc) → hyper+w
                [:i :!CTOSe]                ; O = Gmail (Arc) → hyper+e
                [:o :!CTOSr]                ; U = Google Calendar → hyper+r

                ; Graphite H A E I → hyper+t/y/u/i
                [:j :!CTOSt]                ; H = ChatGPT → hyper+t
                [:k :!CTOSy]                ; A = YouTube → hyper+y
                [:l :!CTOSu]                ; E = Russian dictionary → hyper+u
                [:semicolon :!CTOSi]        ; I = life.itskowi.com → hyper+i

                ; Graphite K P → hyper+o/p
                [:n :!CTOSo]                ; K = Messages → hyper+o
                [:m :!CTOSp]                ; P = Spotify → hyper+p
            ]
        }

        ; =======================================
        ; HOME: H Primary Apps (phys j)
        ; Hyper+1..4 for Hammerspoon
        ; =======================================
        {
            :des "h-primary-apps (Graphite H / phys j)"
            :rules [
                [:condi :h-primary-apps :builtin]

                ; Graphite N R T S → hyper+1..4
                [:a :!CTOS1]                ; N = Cursor itscolby → hyper+1
                [:s :!CTOS2]                ; R = Cursor mopaverse → hyper+2
                [:d :!CTOS3]                ; T = Cursor ~/.config → hyper+3
                [:f :!CTOS4]                ; S = Ghostty → hyper+4

                ; Space: close window (Aerospace)
                [:spacebar :!SOspacebar]    ; Shift+Opt+Space
            ]
        }

        ; =======================================
        ; HOME: A Inner Application Nav (phys k)
        ; =======================================
        {
            :des "a-inner-nav (Graphite A / phys k)"
            :rules [
                [:condi :a-inner-nav :builtin]

                ; Graphite B L D W — page scroll
                [:q :page_up]               ; B = Page Up
                [:w :page_down]             ; L = Page Down
                [:e :!Fleft_arrow]          ; D = Home (top)
                [:r :!Fright_arrow]         ; W = End (bottom)

                ; Graphite N R T S — sidebars (Cursor-ish)
                [:a :!CSb]                  ; N = toggle upper sidebar (Cmd+Shift+B)
                [:s :!Cj]                   ; R = toggle bottom/panel (Cmd+J)
                [:d :!Cb]                   ; T = toggle left sidebar (Cmd+B)
                [:f :!COb]                  ; S = toggle right sidebar (Cmd+Opt+B)

                ; Graphite M C — zoom (phys c / v)
                [:c :!Cequal_sign]          ; M = zoom in (Cmd+=)
                [:v :!Chyphen]              ; C = zoom out (Cmd+-)
            ]
        }

        ; =======================================
        ; HOME: E Clipboard & Edit (phys l)
        ; =======================================
        {
            :des "e-clipboard (Graphite E / phys l)"
            :rules [
                [:condi :e-clipboard :builtin]

                ; Graphite D W
                [:e :!CSv]                  ; D = paste without formatting
                [:r :!CSz]                  ; W = redo

                ; Graphite N R T S
                [:a :!Cc]                   ; N = copy
                [:s :!Cx]                   ; R = cut
                [:d :!Cv]                   ; T = paste
                [:f :!Cz]                   ; S = undo

                ; Space: comment toggle
                [:spacebar :!Cslash]        ; Cmd+/
            ]
        }

        ; =======================================
        ; HOME: I Window Management (phys ;)
        ; Chords only — Hammerspoon handles actions (no Aerospace)
        ; =======================================
        {
            :des "i-window-mgmt (Graphite I / phys ;) — Aerospace Alt+Shift"
            :rules [
                [:condi :i-window-mgmt :builtin]

                ; Graphite L D W
                [:w :!SOd]                  ; L = focus left
                [:e :!SOc]                  ; D = resize smaller
                [:r :!SOv]                  ; W = resize bigger

                ; Graphite N R T S
                [:a :!SOa]                  ; N = swap (Aerospace)
                [:s :!SOs]                  ; R = float toggle (Aerospace)
                [:d :!SOq]                  ; T = accordion (Aerospace)
                [:f :!SOw]                  ; S = tiles/split toggle (Aerospace)

                ; Space: focus right
                [:spacebar :!SOf]
            ]
        }

        ; =======================================
        ; THUMB: B Audio & Display (phys b)
        ; =======================================
        {
            :des "b-audio (phys B hold — Audio; Graphite V alone types V)"
            :rules [
                [:condi :b-audio :builtin]

                ; Graphite L
                [:w :!Cl]                   ; L = screenshot (Cmd+L)

                ; Graphite N R T S
                [:a :mute]                  ; N = Mute
                [:s :volume_increment]      ; R = Volume Up
                [:d :volume_decrement]      ; T = Volume Down
                [:f :display_brightness_increment] ; S = Brightness Up

                ; Graphite Q
                [:z :display_brightness_decrement] ; Q = Brightness Down
            ]
        }

        ; =======================================
        ; THUMB: N Word Deletion (phys n)
        ; =======================================
        {
            :des "n-word-deletion (phys N hold — Word Deletion; Graphite K alone)"
            :rules [
                [:condi :n-word-deletion :builtin]

                ; Graphite B L D W Z
                [:q :!Sreturn_or_enter]     ; B = Shift+Enter (newline)
                [:w :!CFdelete_or_backspace] ; L = delete to line end (Cmd+Delete)
                [:e :!Cdelete_or_backspace] ; D = delete to line start (Cmd+Backspace)
                [:r :!Cclose_bracket]       ; W = indent (Cmd+])
                [:t :!Copen_bracket]        ; Z = deindent (Cmd+[)

                ; Graphite N R T
                [:a :delete_or_backspace]   ; N = Backspace
                [:s :!Odelete_or_backspace] ; R = delete word left (Opt+Backspace)
                [:d :!OFdelete_or_backspace] ; T = delete word right (Opt+Delete)
            ]
        }

        ; =======================================
        ; THUMB: M Word Navigation (phys m)
        ; =======================================
        {
            :des "m-word-navigation (phys M hold — Word Navigation; Graphite P alone)"
            :rules [
                [:condi :m-word-navigation :builtin]

                ; Graphite L D W Z
                [:w :right_arrow]           ; L = Right
                [:e :left_arrow]            ; D = Left
                [:r :up_arrow]              ; W = Up
                [:t :down_arrow]            ; Z = Down

                ; Graphite N R T S
                [:a :!Oleft_arrow]          ; N = word left
                [:s :!Oright_arrow]         ; R = word right
                [:d :!Cright_arrow]         ; T = line end
                [:f :!Cleft_arrow]          ; S = line start
            ]
        }

        ; =======================================
        ; Graphite base letters LAST (builtin only)
        ; Must be after simlayers so layer holds win.
        ; =======================================
        {
            :des "graphite-base-letters (builtin only)"
            :rules [
                :builtin

                ; top row
                [:q :b] [:w :l] [:e :d] [:r :w] [:t :z]
                [:u :f] [:i :o] [:o :u] [:p :j]
                ; home row (y/m/punct keys handled in punct block)
                [:a :n] [:s :r] [:d :t] [:f :s] [:g :g]
                [:h :y] [:j :h] [:k :a] [:l :e] [:semicolon :i]
                ; bottom row
                [:z :q] [:x :x] [:c :m] [:v :c] [:b :v]
                [:n :k] [:m :p]
                ; :y :comma via punct; phys ,/. via punct
            ]
        }

        ; =======================================
        ; Base punctuation LAST (builtin only)
        ; =======================================
        {
            :des "graphite-base-punct (builtin only)"
            :rules [
                :builtin

                ; phys y (Graphite , left of F): comma / "
                [:y :comma]
                [:!Sy :!Squote]
                [:!Ry :!Squote]

                ; phys comma (Graphite . next to P): period / !
                [:comma :period]
                [:!Scomma :!S1]
                [:!Rcomma :!S1]

                ; phys period (Graphite - next to .): hyphen / _
                [:period :hyphen]
                [:!Speriod :!Shyphen]
                [:!Rperiod :!Shyphen]

                ; phys slash (under Graphite I): semicolon / :
                [:slash :semicolon]
                [:!Sslash :!Ssemicolon]
                [:!Rslash :!Ssemicolon]

                ; phys quote (right of I): slash / backslash
                [:quote :slash]
                [:!Squote :backslash]
                [:!Rquote :backslash]

                ; phys [ (right of J): ? / |
                [:open_bracket :!Sslash]
                [:!Sopen_bracket :!Sbackslash]
                [:!Ropen_bracket :!Sbackslash]

                ; phys ] : [ / {
                [:close_bracket :open_bracket]
                [:!Sclose_bracket :!Sopen_bracket]
                [:!Rclose_bracket :!Sopen_bracket]

                ; phys \ : ] / }
                [:backslash :close_bracket]
                [:!Sbackslash :!Sclose_bracket]
                [:!Rbackslash :!Sclose_bracket]
            ]
        }
    ]
}
