{
    :profiles {
        :Default {
            :default true
            :sim     200
            :delay   300
            :alone   400
            :held    400
        }
    }

    :templates {
        :paste "osascript -e '
        set prev to the clipboard
        set the clipboard to \"%s\"
        tell application \"System Events\"
            keystroke \"v\" using command down
            delay 0.1
        end tell
        set the clipboard to prev
        '"
        :paste-left "osascript -e '
        set prev to the clipboard
        set the clipboard to \"%s\"
        tell application \"System Events\"
            keystroke \"v\" using command down
            key code 123
            delay 0.1
        end tell
        set the clipboard to prev
        '"
   }

    :devices {
        :builtin [{:is_built_in_keyboard true}]
    }

    ; Graphite letter → physical QWERTY (Karabiner keycodes):
    ; B→q L→w D→e W→r Z→t  ,→y F→u O→i U→o J→p
    ; N→a R→s T→d S→f G→g  Y→h H→j A→k E→l I→semicolon
    ; Q→z X→x M→c C→v V→b  K→n P→m .→comma -→period /→slash
    ; Simlayer :key is always the PHYSICAL key under the Graphite letter.
    :simlayers {
        ; Upper left (inward → outward): W D L B
        :w-dual-punctuation {:key :r :condi :builtin}       ; Graphite W, QWERTY R
        :d-solo-punctuation {:key :e :condi :builtin}       ; Graphite D, QWERTY E
        :l-logic            {:key :w :condi :builtin}       ; Graphite L, QWERTY W — Logic symbols

        ; Upper right (inward → outward): F O U
        :f-relations        {:key :u :condi :builtin}       ; Graphite F, QWERTY U
        :o-operators        {:key :i :condi :builtin}       ; Graphite O, QWERTY I
        :u-ipa              {:key :o :condi :builtin}       ; Graphite U, QWERTY O

        ; Home left (inward → outward): S T R N
        :s-primary-apps     {:key :f :condi :builtin}       ; Graphite S, QWERTY F — Primary apps
        :t-secondary-apps   {:key :d :condi :builtin}       ; Graphite T, QWERTY D — Secondary apps
        :r-inner-nav        {:key :s :condi :builtin}       ; Graphite R, QWERTY S — Inner app nav
        :n-window-mgmt      {:key :a :condi :builtin}       ; Graphite N, QWERTY A — Window mgmt

        ; Home right (inward → outward): H A E I
        :h-browser          {:key :j :condi :builtin}       ; Graphite H, QWERTY J — Browser
        :a-clipboard        {:key :k :condi :builtin}       ; Graphite A, QWERTY K — Clipboard
        :e-selection        {:key :l :condi :builtin}       ; Graphite E, QWERTY L — Text selection
        :i-find             {:key :semicolon :condi :builtin} ; Graphite I, QWERTY ; — Find

        ; Thumb left — Audio (Glove80 Tab hold). Mac: Graphite M (phys C).
        :m-audio            {:key :c :condi :builtin}       ; Graphite M, QWERTY C

        ; Lower right — Word Nav / Word Del (same holds on Glove80)
        :dot-word-navigation {:key :comma :condi :builtin}  ; Graphite . (under A), QWERTY comma
        :p-word-deletion    {:key :m :condi :builtin}       ; Graphite P, QWERTY M

        ; Vestnik toggle: hold Graphite X (phys X), tap Graphite H (phys J) → F18
        :x-vestnik          {:key :x :condi :builtin}
    }

    :input-sources {
        :russian-phonetic {
            :input_source_id "^com\\.apple\\.keylayout\\.Russian-Phonetic$"
        }
        :us {
            :input_source_id "^com\\.apple\\.keylayout\\.US$"
        }
    }

    :main [
        ; NOTE: Graphite base remaps are at the END of :main so simlayer
        ; rules match first while a layer is held (Karabiner = first match wins).

        ; =======================================
        ; Vestnik toggle (before h-browser, which also uses phys J)
        ; Hold Graphite X, tap Graphite H (phys J) → F18 → Hammerspoon
        ; =======================================
        {
            :des "Vestnik toggle (hold X, tap H)"
            :rules [
                [:condi :x-vestnik :builtin]
                [:j :f18]
            ]
        }

        ; =======================================
        ; UPPER LEFT (inward → outward): W D L B
        ; =======================================

        {
            :des "w-dual-punctuation (Graphite W, QWERTY R)"
            :rules [
                [:condi :w-dual-punctuation :builtin]

                ; Graphite F O U J — wrap pairs (, unused; () on Space)
                [:u [:open_bracket :close_bracket :left_arrow]]   ; F = []
                [:i [:!Sopen_bracket :!Sclose_bracket :left_arrow]] ; O = {}
                [:o [:paste-left "⟨⟩"]]                            ; U = ⟨⟩
                [:p [
                    :grave_accent_and_tilde
                    :grave_accent_and_tilde
                    :left_arrow
                ]]                                                ; J = ``

                ; Graphite H A E I — quotes
                [:j [:!Squote :!Squote :left_arrow]]              ; H = ""
                [:k :!Squote]                                     ; A = "
                [:l [:quote :quote :left_arrow]]                  ; E = ''
                [:semicolon :quote]                               ; I = '

                ; Graphite P . - / — single open/close (K unused)
                [:m :!S9]                                         ; P = (
                [:comma :!S0]                                     ; . = )
                [:period :open_bracket]                           ; - = [
                [:slash :close_bracket]                           ; / = ]

                [:spacebar [:!S9 :!S0 :left_arrow]]               ; Space = ()
            ]
        }

        {
            :des "d-solo-punctuation (Graphite D, QWERTY E)"
            :rules [
                [:condi :d-solo-punctuation :builtin]

                ; Graphite F O U J (, unused)
                [:u :!S5]                   ; F = %
                [:i :!Sgrave_accent_and_tilde] ; O = ~
                [:o :!S6]                   ; U = ^
                [:p :!S4]                   ; J = $

                ; Graphite Y H A E I
                [:h :!S8]                   ; Y = *
                [:j [:paste "…"]]           ; H = …
                [:k :!S3]                   ; A = #
                [:l :!S7]                   ; E = &
                [:semicolon :!S2]           ; I = @

                ; Graphite P .
                [:m [:paste "∅"]]           ; P = ∅
                [:comma [:paste "∞"]]       ; . = ∞

                [:spacebar [:paste "—"]]    ; Space = —
            ]
        }

        {
            :des "l-logic (Graphite L, QWERTY W)"
            :rules [
                [:condi :l-logic :builtin]

                [:u [:paste "⊤"]]           ; F = ⊤
                [:i [:paste "⊥"]]           ; O = ⊥
                [:o [:paste "⊨"]]           ; U = ⊨ (logical consequence)

                [:h [:paste "¬"]]           ; Y = ¬
                [:j [:paste "∧"]]           ; H = ∧
                [:k [:paste "∨"]]           ; A = ∨
                [:l [:paste "∃"]]           ; E = ∃
                [:semicolon [:paste "∀"]]   ; I = ∀

                [:spacebar [:paste "∴"]]    ; Space = ∴
            ]
        }


        ; =======================================
        ; UPPER RIGHT (inward → outward): F O U
        ; =======================================

        {
            :des "f-relations (Graphite F, QWERTY U)"
            :rules [
                [:condi :f-relations :builtin]

                ; row cycle LEFT (Z←B wrap): B≤ L≥ D≅ W≇ Z∝
                [:q [:paste "≤"]]           ; B = ≤
                [:w [:paste "≥"]]           ; L = ≥
                [:e [:paste "≅"]]           ; D = ≅
                [:r [:paste "≇"]]           ; W = ≇
                [:t [:paste "∝"]]           ; Z = ∝

                [:a :!Scomma]               ; N = <
                [:s :!Speriod]              ; R = >
                [:d :equal_sign]            ; T = =
                [:f [:paste "≠"]]           ; S = ≠
                [:g [:paste "≈"]]           ; G = ≈

                [:z [:paste "⊂"]]           ; Q = ⊂
                [:x [:paste "⊃"]]           ; X = ⊃
                [:c [:paste "∈"]]           ; M = ∈
                [:v [:paste "∉"]]           ; C = ∉
                [:b [:paste "∼"]]           ; V = ∼

                [:spacebar [:paste "≔"]]    ; Space = ≔
            ]
        }



        {
            :des "o-operators (Graphite O, QWERTY I)"
            :rules [
                [:condi :o-operators :builtin]

                [:q [:paste "∖"]]           ; B = ∖
                [:w [:paste "×"]]           ; L = ×
                [:e [:paste "∩"]]           ; D = ∩
                [:r [:paste "∪"]]           ; W = ∪
                [:t [:paste "∘"]]           ; Z = ∘

                [:a [:paste "÷"]]           ; N = ÷
                [:s [:paste "·"]]           ; R = ·
                [:d :hyphen]                ; T = -
                [:f :!Sequal_sign]          ; S = +
                [:g [:paste "√"]]           ; G = √

                [:z [:paste "∂"]]           ; Q = ∂
                [:x [:paste "∫"]]           ; X = ∫
                [:c [:paste "∏"]]           ; M = ∏
                [:v [:paste "∑"]]           ; C = ∑
                [:b [:paste "↦"]]           ; V = ↦

                [:spacebar [:paste "±"]]    ; Space = ±
            ]
        }


        {
            :des "u-ipa (Graphite U, QWERTY O) — upper↔middle flipped"
            :rules [
                [:condi :u-ipa :builtin]

                ; former middle row on B L D W Z
                [:q [:paste "ŋ"]]           ; B = ŋ
                [:w [:paste "ɔ"]]           ; L = ɔ
                [:e [:paste "ɛ"]]           ; D = ɛ
                [:r [:paste "ʲ"]]           ; W = ʲ
                [:t [:paste "ø"]]           ; Z = ø

                ; former upper row on N R T S G
                [:a [:paste "ɪ"]]           ; N = ɪ
                [:s [:paste "ɐ"]]           ; R = ɐ
                [:d [:paste "ɨ"]]           ; T = ɨ
                [:f [:paste "ə"]]           ; S = ə
                [:g [:paste "ʊ"]]           ; G = ʊ

                ; consonants on C M X Q V
                [:v [:paste "ʃ"]]           ; C = ʃ
                [:c [:paste "ʒ"]]           ; M = ʒ
                [:x [:paste "ɕ"]]           ; X = ɕ
                [:z [:paste "ʁ"]]           ; Q = ʁ
                [:b [:paste "ç"]]           ; V = ç

                [:spacebar [:paste "ː"]]    ; Space = ː
            ]
        }




        ; =======================================
        ; HOME LEFT (inward → outward): S T R N
        ; =======================================

        {
            :des "s-primary-apps (Graphite S, QWERTY F)"
            :rules [
                [:condi :s-primary-apps :builtin]

                ; flipped to right hand: Y H A E (was N R T S)
                [:h :!CTOS1]                ; Y = Cursor itscolby
                [:j :!CTOS2]                ; H = Cursor mopaverse
                [:k :!CTOS3]                ; A = Cursor ~/.config
                [:l :!CTOS4]                ; E = Ghostty

                [:spacebar :!SOspacebar]    ; Space = close window
            ]
        }

        {
            :des "t-secondary-apps (Graphite T, QWERTY D) — Arc URLs via hyper"
            :rules [
                [:condi :t-secondary-apps :builtin]

                [:y :!CTOSp]                ; , = Spotify
                [:u :!CTOSq]                ; F = WhatsApp
                [:i :!CTOSw]                ; O = GitHub
                [:o :!CTOSe]                ; U = Gmail
                [:p :!CTOSr]                ; J = Calendar

                [:h :!CTOSo]                ; Y = Messages
                [:j :!CTOSt]                ; H = ChatGPT
                [:k :!CTOSy]                ; A = YouTube
                [:l :!CTOSu]                ; E = Russian dict
                [:semicolon :!CTOSi]        ; I = life.itscolby.com

                [:spacebar :delete_forward] ; Space = Delete
            ]
        }

        {
            :des "r-inner-nav (Graphite R, QWERTY S)"
            :rules [
                [:condi :r-inner-nav :builtin]

                [:u :!Cequal_sign]          ; F = zoom in (Cmd+=)
                [:i :!Chyphen]              ; O = zoom out
                [:o :page_up]               ; U = Page Up
                [:p :page_down]             ; J = Page Down

                [:j :!Cb]                   ; H = left sidebar
                [:k :!COb]                  ; A = right sidebar
                [:l :!Cj]                   ; E = bottom/panel
            ]
        }

        {
            :des "n-window-mgmt (Graphite N, QWERTY A) — Aerospace Alt+Shift"
            :rules [
                [:condi :n-window-mgmt :builtin]

                ; Graphite F O U J — send / go workspaces
                [:u :!SO3]                  ; F = send to workspace 1
                [:i :!SO4]                  ; O = send to workspace 2
                [:o :!SO1]                  ; U = go to workspace 1
                [:p :!SO2]                  ; J = go to workspace 2

                ; Graphite Y H A E I
                [:h :!SOa]                  ; Y = swap neighbor
                [:j :!SOd]                  ; H = focus left
                [:k :!SOf]                  ; A = focus right
                [:l :!SOq]                  ; E = accordion
                [:semicolon :!SOw]          ; I = tiles/split

                ; Graphite P .
                [:m :!SOc]                  ; P = resize smaller
                [:comma :!SOv]              ; . = resize bigger
            ]
        }

        ; =======================================
        ; HOME RIGHT (inward → outward): H A E I
        ; =======================================

        {
            :des "h-browser (Graphite H, QWERTY J)"
            :rules [
                [:condi :h-browser :builtin]

                [:w :!TOe]                  ; L = split horiz
                [:e :!Copen_bracket]        ; D = prev link
                [:r :!Cclose_bracket]       ; W = next link

                [:a :!TOq]                  ; N = switch spaces
                [:s :!TOg]                  ; R = new tab
                [:d :!TOd]                  ; T = prev tab
                [:f :!TOf]                  ; S = next tab

                [:spacebar :!TOw]
            ]
        }

        {
            :des "a-clipboard (Graphite A, QWERTY K)"
            :rules [
                [:condi :a-clipboard :builtin]

                [:e :!CSv]
                [:r :!CSz]

                [:a :!Cc]
                [:s :!Cx]
                [:d :!Cv]
                [:f :!Cz]

                [:spacebar :!Cslash]
            ]
        }

        {
            :des "e-selection (Graphite E, QWERTY L)"
            :rules [
                [:condi :e-selection :builtin]

                [:q :!Sup_arrow]
                [:w :!Sdown_arrow]
                [:e :!Sright_arrow]
                [:r :!Sleft_arrow]

                [:a :!SOleft_arrow]         ; N = word left
                [:s :!SOright_arrow]        ; R = word right
                [:d :!SCleft_arrow]         ; T = line beginning
                [:f :!SCright_arrow]        ; S = line ending

                [:spacebar :!Ca]
            ]
        }

        {
            :des "i-find (Graphite I, QWERTY ;)"
            :rules [
                [:condi :i-find :builtin]

                ; Graphite L D W
                [:w :!Ff12]                 ; L = go to definition
                [:e :!COf]                  ; D = find/replace
                [:r :!Cf]                   ; W = find

                ; Graphite N R T S
                [:a :!Ff2]                  ; N = rename symbol
                [:s :!CSg]                  ; R = previous find
                [:d :!Cg]                   ; T = next find
                [:f :!Cs]                   ; S = save

                [:spacebar :escape]         ; Space = Escape
            ]
        }

        ; =======================================
        ; THUMB LAYERS (opp. hand taps; Mac holds = Graphite M / . / P)
        ; =======================================

        {
            :des "m-audio (Graphite M hold — Audio; phys C). Taps on right hand."
            :rules [
                [:condi :m-audio :builtin]

                ; Graphite F O U
                [:u :display_brightness_increment] ; F = Brightness Up
                [:i :display_brightness_decrement] ; O = Brightness Down
                [:o :!Cl]                   ; U = screenshot (Cmd+L)

                ; Graphite H A E I
                [:j :!Cequal_sign]          ; H = zoom in
                [:k :!Chyphen]              ; A = zoom out
                [:l :volume_increment]      ; E = Volume Up
                [:semicolon :volume_decrement] ; I = Volume Down
            ]
        }

        {
            :des "dot-word-navigation (Graphite . hold — Word Nav; phys comma). Taps on left hand."
            :rules [
                [:condi :dot-word-navigation :builtin]

                ; Graphite B L D W (Z unused)
                [:q :down_arrow]            ; B = Down
                [:w :up_arrow]              ; L = Up
                [:e :left_arrow]            ; D = Left
                [:r :right_arrow]           ; W = Right

                ; Graphite N R T S
                [:a :!Oleft_arrow]          ; N = word left
                [:s :!Oright_arrow]         ; R = word right
                [:d :!Cleft_arrow]          ; T = line start
                [:f :!Cright_arrow]         ; S = line end
            ]
        }

        {
            :des "p-word-deletion (Graphite P hold — Word Del; phys M). Taps on left hand."
            :rules [
                [:condi :p-word-deletion :builtin]

                ; Graphite D W
                [:e :!Copen_bracket]        ; D = deindent (Cmd+[)
                [:r :!Cclose_bracket]       ; W = indent (Cmd+])

                ; Graphite N R T S
                [:a :!Odelete_or_backspace] ; N = delete word left (Opt+Backspace)
                [:s :!OFdelete_or_backspace] ; R = delete word right (Opt+Delete)
                [:d :!Cdelete_or_backspace] ; T = delete to line start (Cmd+Backspace)
                [:f :!CFdelete_or_backspace] ; S = delete to line end (Cmd+Delete)

                [:spacebar :delete_forward] ; Space = Delete
            ]
        }

        ; =======================================
        ; Graphite base letters LAST (builtin only)
        ; Must be after simlayers so layer holds win.
        ; =======================================
        {
            :des "graphite-base-letters (builtin only)"
            :rules [
                :builtin

                ; ## = optional any modifiers (Cmd/Ctrl/Opt/Shift kept).
                ; So Cmd+Graphite S (phys F) → Cmd+S save, Cmd+V → paste, etc.
                ; top row
                [:##q :b] [:##w :l] [:##e :d] [:##r :w] [:##t :z]
                [:##u :f] [:##i :o] [:##o :u] [:##p :j]
                ; home row (y/m/punct keys handled in punct block)
                [:##a :n] [:##s :r] [:##d :t] [:##f :s] [:##g :g]
                [:##h :y] [:##j :h] [:##k :a] [:##l :e] [:##semicolon :i]
                ; bottom row
                [:##z :q] [:##x :x] [:##c :m] [:##v :c] [:##b :v]
                [:##n :k] [:##m :p]
                ; :y :comma via punct; phys ,/. via punct
            ]
        }

        ; =======================================
        ; Base punctuation LAST (builtin only)
        ; =======================================
        {
            :des "graphite-base-punct (builtin only)"
            :rules [
                :builtin

                ; phys y (Graphite , left of F): comma / "
                [:##y :comma]
                [:!Sy :!Squote]
                [:!Ry :!Squote]

                ; phys comma (Graphite . next to P): period / !
                [:##comma :period]
                [:!Scomma :!S1]
                [:!Rcomma :!S1]

                ; phys period (Graphite - next to .): hyphen / _
                [:##period :hyphen]
                [:!Speriod :!Shyphen]
                [:!Rperiod :!Shyphen]

                ; phys slash (under Graphite I): semicolon / :
                [:##slash :semicolon]
                [:!Sslash :!Ssemicolon]
                [:!Rslash :!Ssemicolon]

                ; phys quote (right of I): slash / backslash
                [:##quote :slash]
                [:!Squote :backslash]
                [:!Rquote :backslash]

                ; phys [ (right of J): ? / |
                [:##open_bracket :!Sslash]
                [:!Sopen_bracket :!Sbackslash]
                [:!Ropen_bracket :!Sbackslash]

                ; phys ] : [ / {
                [:##close_bracket :open_bracket]
                [:!Sclose_bracket :!Sopen_bracket]
                [:!Rclose_bracket :!Sopen_bracket]

                ; phys \ : ] / }
                [:backslash :close_bracket]
                [:!Sbackslash :!Sclose_bracket]
                [:!Rbackslash :!Sclose_bracket]
            ]
        }
    ]
}
